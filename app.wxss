page {
  --bg: #f4f6f5;
  --surface: #ffffff;
  --surface-2: #eef2f0;
  --surface-3: #e5ebe8;
  --overlay: #f3f6f4;
  --card-bg: #ffffff;
  --card-border: #dfe7e3;
  --border: #e4ebe7;
  --hairline: #edf1ef;
  --text: #17211e;
  --text-dim: #71807a;
  --primary: #0f766e;
  --primary-strong: #115e59;
  --primary-soft: #e2f1ed;
  --accent: #f97316;
  --accent-soft: #fff0e6;
  --success: #159570;
  --warn: #d97706;
  --danger: #dc5b5b;
  --mask: rgba(16, 24, 21, 0.46);
  --sheet-bg: #ffffff;
  --placeholder: #a0ada7;
  --inset: #f3f6f4;
  --radius-sm: 8rpx;
  --radius: 12rpx;
  --radius-lg: 16rpx;
  --gap: 24rpx;
  --pad: 24rpx;
  --shadow-card: 0 6rpx 20rpx rgba(34, 55, 47, 0.045);
  --shadow-btn: 0 6rpx 14rpx rgba(15, 118, 110, 0.16);
  --shadow-glow: none;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

.theme-dark {
  --bg: #111816;
  --surface: #1a2421;
  --surface-2: #202d29;
  --surface-3: #2a3934;
  --overlay: #202d29;
  --card-bg: #1a2421;
  --card-border: #31413b;
  --border: #2b3a35;
  --hairline: #293831;
  --text: #eef5f1;
  --text-dim: #a7b8b0;
  --primary: #53b8a6;
  --primary-strong: #79cfbd;
  --primary-soft: #193c35;
  --accent: #fb923c;
  --accent-soft: #452716;
  --mask: rgba(0, 0, 0, 0.64);
  --sheet-bg: #1a2421;
  --placeholder: #71827b;
  --inset: #202d29;
  --shadow-card: 0 8rpx 22rpx rgba(0, 0, 0, 0.16);
  --shadow-btn: 0 6rpx 16rpx rgba(0, 0, 0, 0.2);
  background: var(--bg);
}

view, text, input, scroll-view, button, picker { box-sizing: border-box; }

button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
  font-size: inherit;
  color: inherit;
}

button::after { border: none; }

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx;
  background: var(--bg);
  color: var(--text);
}

.tab-page { padding-bottom: calc(148rpx + env(safe-area-inset-bottom)); }

.head, .h-top { margin-bottom: 28rpx; }

.h-title {
  display: block;
  color: var(--text);
  font-size: 44rpx;
  font-weight: 760;
  line-height: 1.18;
}

.h-sub {
  display: block;
  margin-top: 10rpx;
  color: var(--text-dim);
  font-size: 24rpx;
  line-height: 1.55;
}

.section { margin-top: 32rpx; }

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.section-title { color: var(--text); font-size: 30rpx; font-weight: 700; }
.section-meta { color: var(--text-dim); font-size: 22rpx; }

.card {
  padding: var(--pad);
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius);
  background: var(--card-bg);
  box-shadow: var(--shadow-card);
}

.card-title {
  display: block;
  margin-bottom: 18rpx;
  color: var(--text);
  font-size: 30rpx;
  font-weight: 700;
}

.metric-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }

.metric-card {
  min-width: 0;
  padding: 20rpx 16rpx;
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius-sm);
  background: var(--surface);
}

.metric-value { display: block; color: var(--text); font-size: 38rpx; font-weight: 760; line-height: 1.1; }
.metric-label { display: block; margin-top: 9rpx; color: var(--text-dim); font-size: 21rpx; line-height: 1.3; }
.metric-note { display: block; margin-top: 6rpx; color: var(--text-dim); font-size: 19rpx; line-height: 1.3; }
.grad-text { color: var(--primary); }

.btn-primary, .btn-save, .btn-start {
  width: 100%;
  padding: 21rpx 24rpx;
  border: 0;
  border-radius: var(--radius-sm);
  background: var(--primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
  box-shadow: var(--shadow-btn);
}

.btn-secondary, .btn-add, .btn-ghost {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--text);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.btn-import {
  width: 100%;
  padding: 19rpx 24rpx;
  border: 1rpx dashed var(--primary);
  border-radius: var(--radius-sm);
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.4;
}

.btn-primary:active, .btn-save:active, .btn-start:active,
.btn-secondary:active, .btn-add:active, .btn-ghost:active, .btn-import:active { opacity: 0.82; }
.btn-primary[disabled], .btn-save[disabled], .btn-start[disabled], .btn-secondary[disabled] { opacity: 0.5; }

.pill-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--text);
  font-size: 25rpx;
  font-weight: 600;
}

.chip, .tag {
  display: inline-block;
  border-radius: 999rpx;
  white-space: nowrap;
}

.chip {
  margin-right: 10rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid var(--border);
  background: var(--surface);
  color: var(--text-dim);
  font-size: 23rpx;
}

.chip-on { border-color: var(--primary); background: var(--primary); color: #fff; }
.tag { padding: 6rpx 12rpx; background: var(--primary-soft); color: var(--primary-strong); font-size: 20rpx; }
.tag.dim { background: var(--surface-2); color: var(--text-dim); }

.input, .search-input {
  width: 100%;
  height: 82rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface-2);
  color: var(--text);
  font-size: 27rpx;
  line-height: 82rpx;
}

.search-input { height: 78rpx; padding: 0 20rpx; line-height: 78rpx; background: var(--surface); }

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 84rpx 28rpx;
  color: var(--text-dim);
  text-align: center;
}

.empty-text { color: var(--text); font-size: 28rpx; font-weight: 650; }
.empty-sub { color: var(--text-dim); font-size: 23rpx; line-height: 1.5; }
.empty-emoji { display: none; }
.loading { padding: 90rpx 0; color: var(--text-dim); font-size: 25rpx; text-align: center; }
.divider { height: 1rpx; margin: 16rpx 0; background: var(--hairline); }

@keyframes fadeUp { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: none; } }
@keyframes sheetUp { from { transform: translateY(100%); } to { transform: none; } }

.page > view:not(.picker-mask):not(.plan-picker-mask) { animation: fadeUp 0.16s ease-out both; }
.sheet, .plan-sheet { animation: sheetUp 0.22s ease-out both; }
