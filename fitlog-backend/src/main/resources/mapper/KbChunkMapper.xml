<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fitlog.backend.repository.KbChunkMapper">
    <sql id="columns">
        id, source, ref_id, chunk_text, embedding, meta_json, created_at
    </sql>

    <select id="selectAll" resultType="KbChunk">
        SELECT <include refid="columns"/> FROM kb_chunks
    </select>

    <select id="selectBySource" resultType="KbChunk">
        SELECT <include refid="columns"/> FROM kb_chunks WHERE source = #{source}
    </select>

    <insert id="insert" parameterType="KbChunk" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO kb_chunks (source, ref_id, chunk_text, embedding, meta_json)
        VALUES (#{source}, #{refId}, #{chunkText}, #{embedding}, #{metaJson})
    </insert>
</mapper>
