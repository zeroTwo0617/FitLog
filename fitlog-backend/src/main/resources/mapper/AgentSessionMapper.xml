<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fitlog.backend.repository.AgentSessionMapper">
    <sql id="columns">
        id, openid, messages, updated_at
    </sql>

    <select id="selectByOpenid" resultType="AgentSession">
        SELECT <include refid="columns"/> FROM agent_sessions WHERE openid = #{openid}
    </select>

    <insert id="insert" parameterType="AgentSession" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO agent_sessions (openid, messages)
        VALUES (#{openid}, #{messages})
    </insert>
</mapper>
