.tabbar-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
  pointer-events: none;
}

.tabbar {
  display: flex;
  min-height: 104rpx;
  padding: 8rpx 14rpx 10rpx;
  border-top: 1rpx solid var(--card-border);
  border-radius: 20rpx 20rpx 0 0;
  background-color: #ffffff;
  opacity: 1;
  box-shadow: 0 -8rpx 24rpx rgba(21, 42, 35, 0.06);
  pointer-events: auto;
}

.theme-dark.tabbar { background-color: #1a2421; }

.tab {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  min-width: 0;
  border-radius: 10rpx;
  color: var(--text-dim);
}

.tab::before {
  position: absolute;
  top: -8rpx;
  width: 32rpx;
  height: 4rpx;
  border-radius: 0 0 5rpx 5rpx;
  background: transparent;
  content: '';
}

.tab.active {
  background: var(--primary-soft);
  color: var(--primary);
}

.tab.active::before { background: var(--primary); }

.tab-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.tab-label {
  overflow: hidden;
  max-width: 100%;
  color: currentColor;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab.active .tab-label {
  color: var(--primary);
  font-weight: 750;
}
