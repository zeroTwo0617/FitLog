.tabbar-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding: 0;
  pointer-events: none;
}

.tabbar {
  display: flex;
  min-height: 108rpx;
  padding: 10rpx 12rpx;
  padding-bottom: calc(10rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--card-border);
  border-radius: 0;
  background-color: rgba(24, 29, 25, 0.96);
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(14px);
  pointer-events: auto;
}

.theme-light.tabbar {
  background-color: rgba(255, 255, 255, 0.97);
  box-shadow: 0 -6rpx 20rpx rgba(21, 42, 35, 0.06);
}

.tab {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  min-width: 0;
  border-radius: 18rpx;
  color: var(--text-dim);
}

.tab.active {
  color: var(--primary);
}

.tab-icon {
  display: block;
  width: 42rpx;
  height: 42rpx;
}

.tab.active .tab-icon {
  transform: translateY(-2rpx);
}

.tab-label {
  overflow: hidden;
  max-width: 100%;
  color: currentColor;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab.active .tab-label {
  color: var(--primary);
  font-weight: 750;
}

/* 选中态下方 Volt 小圆点 */
.tab::after {
  width: 6rpx;
  height: 6rpx;
  margin-top: 1rpx;
  border-radius: 50%;
  background: transparent;
  content: '';
}

.tab.active::after { background: var(--primary); }
