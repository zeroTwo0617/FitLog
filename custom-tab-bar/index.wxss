.tabbar-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
  pointer-events: none;
}

.tabbar {
  display: flex;
  min-height: 104rpx;
  padding: 8rpx 14rpx 10rpx;
  border-top: 1rpx solid var(--card-border);
  border-radius: 20rpx 20rpx 0 0;
  background-color: #ffffff;
  opacity: 1;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  box-shadow: 0 -8rpx 24rpx rgba(21, 42, 35, 0.06);
  pointer-events: auto;
}

.theme-dark.tabbar {
  background-color: #1a2421;
}

.tab {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  min-width: 0;
  border-radius: 10rpx;
  color: var(--text-dim);
}

.tab.active {
  background: var(--primary-soft);
  color: var(--primary);
}

.tab-icon {
  position: relative;
  display: block;
  width: 34rpx;
  height: 30rpx;
  color: currentColor;
}

.icon-home::before {
  position: absolute;
  right: 4rpx;
  bottom: 1rpx;
  left: 4rpx;
  height: 19rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
  content: '';
}

.icon-home::after {
  position: absolute;
  top: 2rpx;
  left: 7rpx;
  width: 18rpx;
  height: 18rpx;
  border-top: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  transform: rotate(45deg);
  content: '';
}

.icon-library::before {
  position: absolute;
  top: 3rpx;
  left: 4rpx;
  width: 26rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: currentColor;
  box-shadow: 0 9rpx 0 currentColor, 0 18rpx 0 currentColor;
  content: '';
}

.icon-library::after {
  position: absolute;
  top: 0;
  left: 0;
  width: 3rpx;
  height: 25rpx;
  border-radius: 3rpx;
  background: currentColor;
  content: '';
}

.icon-spark::before {
  position: absolute;
  top: -2rpx;
  left: 6rpx;
  color: currentColor;
  content: '✦';
  font-size: 34rpx;
  line-height: 30rpx;
}

.icon-calendar::before {
  position: absolute;
  top: 4rpx;
  right: 3rpx;
  bottom: 0;
  left: 3rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
  content: '';
}

.icon-calendar::after {
  position: absolute;
  top: 10rpx;
  left: 7rpx;
  width: 20rpx;
  height: 3rpx;
  background: currentColor;
  box-shadow: 0 7rpx 0 currentColor;
  content: '';
}

.icon-profile::before {
  position: absolute;
  top: 1rpx;
  left: 11rpx;
  width: 11rpx;
  height: 11rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  content: '';
}

.icon-profile::after {
  position: absolute;
  right: 5rpx;
  bottom: 0;
  left: 5rpx;
  height: 13rpx;
  border: 2rpx solid currentColor;
  border-radius: 14rpx 14rpx 4rpx 4rpx;
  content: '';
}

.tab-label {
  overflow: hidden;
  max-width: 100%;
  color: currentColor;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}
