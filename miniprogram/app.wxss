/* FitLog design system: light paper, clear hierarchy, low visual noise. */
page {
  --bg: #e6e9e3;
  --surface: #f8f9f6;
  --surface-2: #eef1eb;
  --surface-3: #e1e6dd;
  --overlay: #ffffff;
  --card-bg: #ffffff;
  --card-border: #d9ddd4;
  --border: #c8cec3;
  --hairline: #e3e7df;
  --text: #191b19;
  --text-dim: #70766d;
  --primary: #b4dc16;
  --primary-strong: #6e8f00;
  --primary-soft: #edf5d8;
  --on-primary: #1c2414;
  --accent: #f2932f;
  --accent-soft: #fff0dc;
  --teal: #3f8f7d;
  --success: #6e8f00;
  --warn: #f2932f;
  --danger: #c9533d;
  --mask: rgba(25, 27, 25, 0.48);
  --sheet-bg: #f8f9f6;
  --placeholder: #a1a79d;
  --inset: #f1f3ee;
  --radius-sm: 12rpx;
  --radius: 16rpx;
  --radius-lg: 20rpx;
  --gap: 20rpx;
  --pad: 28rpx;
  --shadow-card: 0 8rpx 24rpx rgba(28, 35, 27, 0.06);
  --shadow-btn: 0 6rpx 16rpx rgba(110, 143, 0, 0.18);
  background: var(--bg);
  color: var(--text);
  font-family: "Arial Narrow", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.theme-dark {
  --bg: #070908;
  --surface: #101411;
  --surface-2: #181d19;
  --surface-3: #242b24;
  --overlay: #161b17;
  --card-bg: #141915;
  --card-border: #2d382e;
  --border: #3b483c;
  --hairline: #273128;
  --text: #f2f5ef;
  --text-dim: #9da99d;
  --primary: #c4e63b;
  --primary-strong: #d8f27a;
  --primary-soft: #2a3714;
  --on-primary: #13190d;
  --accent: #f5a34b;
  --accent-soft: #3a2917;
  --teal: #78c5ae;
  --success: #c4e63b;
  --warn: #f5a34b;
  --danger: #f28b78;
  --mask: rgba(0, 0, 0, 0.72);
  --sheet-bg: #121713;
  --placeholder: #6d796e;
  --inset: #1d241e;
  --shadow-card: 0 8rpx 24rpx rgba(0, 0, 0, 0.34);
  --shadow-btn: 0 6rpx 16rpx rgba(196, 230, 59, 0.14);
}

view, text, input, scroll-view, button, picker { box-sizing: border-box; }

button {
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: normal;
}

button::after { border: none; }

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  background: var(--surface);
  color: var(--text);
}

.tab-page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }
.head, .h-top { margin-bottom: 28rpx; }

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: var(--text-dim);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.35;
}

.h-title {
  display: block;
  color: var(--text);
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.1;
}

.h-sub {
  display: block;
  max-width: 560rpx;
  margin-top: 10rpx;
  color: var(--text-dim);
  font-size: 24rpx;
  line-height: 1.55;
}

.section { margin-top: 30rpx; }
.section-head, .section-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.section-title { color: var(--text); font-size: 31rpx; font-weight: 900; }
.section-meta { color: var(--text-dim); font-size: 21rpx; }

.card {
  padding: var(--pad);
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius);
  background: var(--card-bg);
  box-shadow: var(--shadow-card);
}

.card-title { display: block; margin-bottom: 18rpx; color: var(--text); font-size: 32rpx; font-weight: 900; }

.metric-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.metric-card { min-width: 0; padding: 20rpx 16rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--card-bg); }
.metric-value { display: block; color: var(--text); font-size: 42rpx; font-weight: 900; line-height: 1.1; }
.metric-label { display: block; margin-top: 8rpx; color: var(--text-dim); font-size: 22rpx; line-height: 1.3; }
.metric-note { display: block; margin-top: 5rpx; color: var(--text-dim); font-size: 20rpx; line-height: 1.35; }
.grad-text { color: var(--primary-strong); }

.btn-primary, .btn-save, .btn-start {
  width: 100%;
  padding: 22rpx 24rpx;
  border-radius: 10rpx;
  background: var(--primary);
  color: var(--on-primary);
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
  box-shadow: var(--shadow-btn);
}
.btn-secondary, .btn-add, .btn-ghost {
  width: 100%;
  padding: 21rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  background: var(--surface);
  color: var(--text);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
}
.btn-import { width: 100%; padding: 20rpx 24rpx; border: 1rpx dashed var(--primary-strong); border-radius: 10rpx; background: var(--primary-soft); color: var(--primary-strong); font-size: 26rpx; font-weight: 800; line-height: 1.35; }
.btn-primary:active, .btn-save:active, .btn-start:active, .btn-secondary:active, .btn-add:active, .btn-ghost:active, .btn-import:active { opacity: 0.72; }
.btn-primary[disabled], .btn-save[disabled], .btn-start[disabled] { opacity: 0.48; background: var(--primary) !important; color: var(--on-primary) !important; }
.btn-secondary[disabled], .btn-add[disabled], .btn-ghost[disabled] { opacity: 0.48; background: var(--surface) !important; color: var(--text-dim) !important; }

.pill-btn { display: flex; align-items: center; justify-content: center; min-height: 68rpx; padding: 0 18rpx; border: 1rpx solid var(--border); border-radius: 999rpx; background: transparent; color: var(--text); font-size: 24rpx; font-weight: 800; }
.chip, .tag { display: inline-block; border-radius: 999rpx; white-space: nowrap; }
.chip { margin-right: 10rpx; padding: 10rpx 17rpx; border: 1rpx solid var(--border); background: transparent; color: var(--text-dim); font-size: 23rpx; font-weight: 700; }
.chip-on { border-color: var(--primary); background: var(--primary-soft); color: var(--primary-strong); }
.tag { padding: 7rpx 13rpx; background: var(--primary-soft); color: var(--primary-strong); font-size: 21rpx; font-weight: 800; }
.tag.dim { background: var(--surface-2); color: var(--text-dim); }

.input, .search-input { width: 100%; height: 78rpx; padding: 0 18rpx; border: 1rpx solid var(--border); border-radius: 10rpx; background: var(--card-bg); color: var(--text); font-size: 26rpx; line-height: 78rpx; }
.search-input { height: 82rpx; padding: 0 20rpx; line-height: 82rpx; }
.empty { display: flex; flex-direction: column; align-items: center; gap: 9rpx; padding: 76rpx 24rpx; color: var(--text-dim); text-align: center; }
.empty-text { color: var(--text); font-size: 27rpx; font-weight: 800; }
.empty-sub { color: var(--text-dim); font-size: 23rpx; line-height: 1.5; }
.empty-emoji { display: none; }
.loading { padding: 84rpx 0; color: var(--text-dim); font-size: 26rpx; text-align: center; }
.divider { height: 1rpx; margin: 16rpx 0; background: var(--hairline); }
.error-note { padding: 14rpx 16rpx; border: 1rpx solid var(--danger); border-radius: 10rpx; background: var(--accent-soft); color: var(--danger); font-size: 23rpx; line-height: 1.45; }

@keyframes fadeUp { from { opacity: 0; transform: translateY(8rpx); } to { opacity: 1; transform: none; } }
@keyframes sheetUp { from { transform: translateY(100%); } to { transform: none; } }
.page > view:not(.picker-mask):not(.plan-picker-mask) { animation: fadeUp 0.16s ease-out both; }
.sheet, .plan-sheet { animation: sheetUp 0.22s ease-out both; }
