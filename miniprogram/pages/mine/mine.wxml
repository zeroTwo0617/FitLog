<view class="page tab-page mine-page theme-{{theme ? theme : 'dark'}}">
  <view class="mine-header"><view class="avatar-large">FL</view><view class="profile-copy"><text class="eyebrow">YOUR SPACE</text><text class="profile-name">{{displayName}}</text><view class="sync-status pstatus-{{cloud.status}}"><view class="status-dot"></view><text>{{cloud.text}}</text></view></view></view>

  <view class="mine-summary"><view class="sum-hl"><text>{{workoutCount}}</text><text>训练记录</text></view><view><text>{{planCount}}</text><text>训练计划</text></view><view><text>{{weekDone}}<text class="sum-unit"> / 7</text></text><text>本周打卡</text></view></view>

  <view class="profile-section"><view class="section-title-row"><text>个人状态</text><text>资料摘要</text></view><view class="kv-list"><view class="kv-row"><text class="kv-k">训练目标</text><text class="kv-v">{{goalText}}</text></view><view class="kv-row"><text class="kv-k">训练水平</text><text class="kv-v kv-volt">{{levelText}}</text></view><view class="kv-row" bindtap="goBody"><text class="kv-k">身体数据</text><view class="kv-side"><text class="kv-v">{{bodySummary.weight}} · BMI {{bodySummary.bmi}}</text><text class="kv-arrow">›</text></view></view></view></view>

  <view class="link-section"><text class="group-label">数据管理</text><view class="menu-card"><view class="menu-row" bindtap="goHistory"><view class="menu-ic mi-orange"><image src="/assets/icons/quick-history{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" /></view><text class="menu-t">训练历史</text><text class="menu-a">›</text></view><view class="menu-row" bindtap="goPlans"><view class="menu-ic mi-volt"><image src="/assets/icons/quick-plan{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" /></view><text class="menu-t">训练计划</text><text class="menu-a">›</text></view><view class="menu-row" bindtap="goStats"><view class="menu-ic mi-teal"><image src="/assets/icons/quick-stats{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" /></view><text class="menu-t">数据统计</text><text class="menu-a">›</text></view><view class="menu-row" bindtap="goBody"><view class="menu-ic mi-plain"><image src="/assets/icons/quick-body{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" /></view><text class="menu-t">身体数据</text><text class="menu-a">›</text></view><view class="menu-row" bindtap="exportData"><view class="menu-ic mi-volt"><image src="/assets/icons/export{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" /></view><text class="menu-t">导出数据</text><text class="menu-a">›</text></view><view class="menu-row" bindtap="loadSeed"><view class="menu-ic mi-plain"><image src="/assets/icons/sparkles-default{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" /></view><text class="menu-t">载入测试数据</text><text class="menu-a">›</text></view></view></view>

  <view class="settings-group appearance"><text class="group-label">应用设置</text><view class="menu-item" bindtap="toggleTheme"><view><text>深色模式</text><text>{{theme === 'dark' ? '当前已开启' : '当前为浅色模式'}}</text></view><view class="switch {{theme === 'dark' ? 'dark' : 'light'}}"><view></view></view></view><view class="menu-item static-item"><view><text>关于 FitLog</text><text>训练记录本 · v1.0.0</text></view><text>·</text></view></view>
  <text class="mine-foot">FitLog · 让进步可见</text>
</view>
