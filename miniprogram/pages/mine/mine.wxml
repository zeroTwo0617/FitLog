<view class="page tab-page mine-page theme-{{theme ? theme : 'dark'}}">
  <view class="mine-header"><view class="avatar-large">FL</view><view class="profile-copy"><text class="eyebrow">TRAINING WITH PURPOSE</text><text class="profile-name">{{displayName}}</text><text class="profile-tagline">保持节奏，比追求完美更重要。</text><view class="sync-status pstatus-{{cloud.status}}"><view class="status-dot"></view><text>{{cloud.text}}</text></view></view></view>

  <view class="link-section"><view class="section-title-row"><text>我的数据</text><text>{{workoutCount}} 次训练 · {{planCount}} 个计划</text></view><view class="menu-card"><view class="menu-row" bindtap="goPlans"><view class="menu-ic mi-volt"><image src="/assets/icons/quick-plan{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" /></view><view class="menu-copy"><text class="menu-t">我的训练计划</text><text class="menu-sub">{{planCount}} 个计划 · 进入编辑</text></view><text class="menu-a">›</text></view><view class="menu-row" bindtap="goBody"><view class="menu-ic mi-plain"><image src="/assets/icons/quick-body{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" /></view><view class="menu-copy"><text class="menu-t">身体数据</text><text class="menu-sub">{{bodySummary.weight}} · BMI {{bodySummary.bmi}}</text></view><text class="menu-a">›</text></view><view class="menu-row" bindtap="goNutrition"><view class="menu-ic mi-orange"><image src="/assets/icons/quick-history{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" /></view><view class="menu-copy"><text class="menu-t">饮食记录</text><text class="menu-sub">{{todayNutritionText}}</text></view><text class="menu-a">›</text></view></view></view>

  <view class="link-section secondary-links"><view class="section-title-row"><text>训练数据</text><text>持续回看进步</text></view><view class="menu-card"><view class="menu-row" bindtap="goHistory"><view class="menu-ic mi-orange"><image src="/assets/icons/quick-history{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" /></view><view class="menu-copy"><text class="menu-t">训练历史</text><text class="menu-sub">回看每次训练记录</text></view><text class="menu-a">›</text></view><view class="menu-row" bindtap="goStats"><view class="menu-ic mi-teal"><image src="/assets/icons/quick-stats{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" /></view><view class="menu-copy"><text class="menu-t">数据统计</text><text class="menu-sub">趋势与个人记录</text></view><text class="menu-a">›</text></view><view class="menu-row" bindtap="exportData"><view class="menu-ic mi-volt"><image src="/assets/icons/export{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" /></view><view class="menu-copy"><text class="menu-t">导出数据</text><text class="menu-sub">保存一份训练档案</text></view><text class="menu-a">›</text></view></view></view>

  <text class="mine-foot">FitLog · 让进步可见</text>
</view>
