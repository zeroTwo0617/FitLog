.mine-page { padding-top: 30rpx; }
.profile-intro { display: grid; grid-template-columns: 72rpx minmax(0, 1fr); align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.avatar { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--text); color: var(--surface); font-size: 23rpx; font-weight: 900; letter-spacing: 1rpx; }
.profile-copy { min-width: 0; }
.profile-copy .eyebrow { margin-bottom: 4rpx; font-size: 16rpx; }
.profile-name { display: block; overflow: hidden; color: var(--text); font-size: 31rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.profile-tagline { display: block; margin-top: 6rpx; color: var(--text-dim); font-size: 19rpx; line-height: 1.35; }
.profile-stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 14rpx 0 32rpx; border-top: 1rpx solid var(--border); border-bottom: 1rpx solid var(--border); }
.profile-stats view { padding: 15rpx 6rpx; text-align: center; }
.profile-stats view + view { border-left: 1rpx solid var(--hairline); }
.profile-stats text { display: block; }
.profile-stats text:first-child { color: var(--text); font-size: 25rpx; font-weight: 900; }
.profile-stats text:last-child { margin-top: 5rpx; color: var(--text-dim); font-size: 17rpx; }
.settings-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 11rpx; }
.tools-head { margin-top: 30rpx; }
.settings-list { border-top: 1rpx solid var(--border); }
.setting-row { display: flex; align-items: center; gap: 13rpx; padding: 14rpx 0; border-bottom: 1rpx solid var(--hairline); }
.setting-row:active { opacity: .62; }
.setting-icon { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; flex: 0 0 auto; border-radius: 10rpx; }
.setting-icon image { width: 27rpx; height: 27rpx; }
.lime-icon { background: var(--primary-soft); }
.orange-icon { background: var(--accent-soft); }
.rust-icon { background: #fbe9e3; }
.teal-icon { background: #e4f1ed; }
.plain-icon { background: var(--surface-2); }
.row-copy { flex: 1; min-width: 0; }
.setting-title, .setting-sub { display: block; }
.setting-title { color: var(--text); font-size: 23rpx; font-weight: 900; }
.setting-sub { overflow: hidden; margin-top: 5rpx; color: var(--text-dim); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.row-arrow { flex: 0 0 auto; color: var(--text-dim); font-size: 34rpx; font-weight: 300; line-height: 1; }
.mine-foot { display: block; margin-top: 34rpx; color: var(--text-dim); font-size: 17rpx; letter-spacing: 1rpx; text-align: center; }
