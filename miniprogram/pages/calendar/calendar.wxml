<view class="page tab-page calendar-page theme-{{theme ? theme : 'dark'}}">
  <view class="calendar-header">
    <view><text class="eyebrow">TRAINING LOG</text><text class="h-title">训练日历</text><text class="h-sub">选中日期，在当前页面查看训练和饮食记录</text></view>
    <view class="month-total"><text>{{monthWorkoutCount}}</text><text>本月训练</text></view>
  </view>

  <view class="streak-card">
    <view class="streak-copy">
      <text class="streak-label">连续训练</text>
      <text class="streak-num">{{weekStreak}} 周</text>
      <text class="streak-sub">本月已打卡 {{monthWorkoutCount}} 次 · 累计 {{trainedDays}} 个训练日</text>
    </view>
    <view class="streak-flame">
      <image src="/assets/icons/flame{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" />
    </view>
  </view>

  <view class="calendar-summary">
    <view><text>{{trainedDays}}</text><text>累计训练日</text></view>
    <view><text>{{workoutCount}}</text><text>训练次数</text></view>
    <view><text>{{monthCalories}}</text><text>本月 kcal</text></view>
  </view>

  <view class="loading" wx:if="{{loading}}">正在加载日历</view>
  <block wx:if="{{!loading}}">
    <view class="calendar-board">
      <view class="calendar-toolbar">
        <view><text class="calendar-month">{{calYear}} / {{calMonth}}</text><text class="calendar-caption">训练与摄入</text></view>
        <view class="calendar-nav"><view class="calendar-arrow {{canPrev ? '' : 'disabled'}}" bindtap="prevMonth">‹</view><view class="calendar-arrow {{canNext ? '' : 'disabled'}}" bindtap="nextMonth">›</view></view>
      </view>
      <view class="calendar-week"><text wx:for="{{weekLabels}}" wx:key="*this">{{item}}</text></view>
      <view class="calendar-grid">
        <view wx:for="{{calendar}}" wx:key="dateStr" class="calendar-cell {{item.trained ? 'trained' : ''}} {{item.isToday ? 'today' : ''}} {{selectedDate === item.dateStr ? 'selected' : ''}}" data-date="{{item.dateStr}}" bindtap="tapDay">
          <text class="calendar-day {{item.dateStr === '' ? 'blank' : ''}}">{{item.day}}</text>
          <text class="calendar-count" wx:if="{{item.count > 1}}">{{item.count}}</text>
          <view class="calorie-dot {{item.calorieStatus}}" wx:if="{{item.calories > 0}}"></view>
        </view>
      </view>
      <view class="calendar-legend"><view class="legend-item"><view class="legend-dot trained"></view><text>已训练</text></view><view class="legend-item"><view class="legend-dot today"></view><text>今天</text></view><view class="legend-item"><view class="legend-dot selected"></view><text>已选择</text></view></view>
    </view>

    <view class="day-detail" wx:if="{{selectedDate}}">
      <view class="detail-header"><view><text class="detail-date">{{selectedDate}}</text><text class="detail-summary" wx:if="{{selectedSessionCount > 0}}">{{selectedSessionCount}} 次训练 · {{selectedExerciseCount}} 个动作 · {{selectedSetCount}} 组</text><text class="detail-summary" wx:if="{{selectedSessionCount === 0}}">休息日，没有训练记录</text></view><view class="detail-close" bindtap="tapDay" data-date="{{selectedDate}}">×</view></view>
      <view class="nutrition-summary" wx:if="{{selectedNutrition}}" bindtap="openNutrition" data-date="{{selectedDate}}"><view class="nutrition-summary-head"><text class="nutrition-title">饮食 {{selectedNutrition.calories}} kcal · {{selectedNutrition.mealCount}} 餐</text><text class="nutrition-action">修改 →</text></view><text class="nutrition-macro">目标 {{dailyTargetCalories || '未设置'}} kcal · 蛋白质 {{selectedNutrition.protein}}g · 碳水 {{selectedNutrition.carbs}}g · 脂肪 {{selectedNutrition.fat}}g</text><view wx:for="{{selectedNutrition.meals}}" wx:key="_id" class="nutrition-meal"><text>{{item.mealTypeLabel}}</text><text>{{item.calories}} kcal</text></view></view>
      <view class="nutrition-empty" wx:if="{{selectedDate && !selectedNutrition}}"><text>暂无饮食记录</text><text class="nutrition-action" bindtap="openNutrition" data-date="{{selectedDate}}">添加饮食 →</text></view>
      <view class="detail-loading" wx:if="{{detailLoading}}">正在整理当日训练</view>
      <view class="detail-empty" wx:if="{{!detailLoading && selectedSessionCount === 0}}">把休息也记录下来，节奏才能持续。</view>
      <view class="detail-session" wx:for="{{selectedWorkouts}}" wx:key="id" wx:for-item="workout"><view class="session-head"><text class="session-title">{{workout.title}}</text><text class="session-meta">{{workout.time}} · {{workout.exerciseCount}} 个动作 · {{workout.totalSets}} 组</text></view><view class="detail-group" wx:for="{{workout.groups}}" wx:key="exerciseId" wx:for-item="group"><view class="group-head"><text class="group-name">{{group.name}}</text><text class="group-count">{{group.setCount}} 组</text></view><view class="detail-set detail-set-head"><text>组</text><text>次数</text><text>重量</text><text>休息</text></view><view class="detail-set" wx:for="{{group.sets}}" wx:key="setIndex" wx:for-item="set"><text>{{set.setIndex}}</text><text>{{set.repsText}}</text><text>{{set.weightText}}</text><text>{{set.restText}}</text></view></view></view>
    </view>
  </block>
</view>
