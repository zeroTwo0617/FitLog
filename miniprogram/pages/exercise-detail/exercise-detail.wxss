.page.detail { padding-top: 30rpx; padding-bottom: 54rpx; }
.detail-heading { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.detail-index { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; flex: 0 0 auto; border-radius: 14rpx; background: var(--text); color: var(--surface); font-size: 35rpx; font-weight: 900; }
.detail-heading .eyebrow { margin-bottom: 5rpx; }
.name { display: block; color: var(--text); font-size: 42rpx; font-weight: 900; line-height: 1.15; }
.name-en { display: block; margin-top: 5rpx; color: var(--text-dim); font-size: 20rpx; }
.tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 24rpx; }
.detail-facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rpx; margin-bottom: 28rpx; border: 1rpx solid var(--border); background: var(--border); }
.detail-facts view { min-width: 0; padding: 14rpx 10rpx; background: var(--card-bg); }
.detail-facts text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.detail-facts text:first-child { color: var(--text-dim); font-size: 19rpx; }
.detail-facts text:last-child { margin-top: 7rpx; color: var(--text); font-size: 23rpx; font-weight: 900; }
.detail-section { border-top: 1rpx solid var(--border); }
.detail-section .section-kicker { margin: 20rpx 0 5rpx; }
.detail-section .accent-mark { display: inline-block; width: 5rpx; height: 24rpx; background: var(--primary); }
.step { display: flex; gap: 13rpx; padding: 15rpx 0; border-bottom: 1rpx solid var(--hairline); }
.step-no { display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; flex: 0 0 auto; border-radius: 50%; background: var(--primary-soft); color: var(--primary-strong); font-size: 20rpx; font-weight: 900; }
.step-txt { flex: 1; color: var(--text); font-size: 26rpx; line-height: 1.6; }
.tip-section { margin-top: 24rpx; padding: 16rpx; border-left: 4rpx solid var(--accent); background: var(--accent-soft); }
.tip-title, .tip-copy { display: block; }
.tip-title { color: var(--accent); font-size: 22rpx; font-weight: 900; }
.tip-copy { margin-top: 7rpx; color: #8a684b; font-size: 21rpx; line-height: 1.5; }
