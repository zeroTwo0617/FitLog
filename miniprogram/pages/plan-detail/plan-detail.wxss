.d-name { display: block; font-size: 54rpx; font-weight: 700; }
.d-sub { display: block; margin-top: 12rpx; color: var(--text-dim); font-size: 28rpx; }

.items { display: flex; flex-direction: column; gap: 18rpx; }
/* 动作项：外观由全局 .card 提供 */
.d-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.d-ex { font-size: 35rpx; font-weight: 600; flex: 1; min-width: 0; }
.d-targets { display: flex; gap: 10rpx; flex-shrink: 0; }
.d-chip {
  font-size: 24rpx; padding: 8rpx 16rpx; border-radius: 999rpx;
  background: var(--primary-soft); color: var(--primary-strong); white-space: nowrap;
}
.d-chip.dim { background: var(--inset); color: var(--text-dim); }

.btn-start { margin-top: 40rpx; }

/* 删除计划：次要危险操作，与主按钮拉开层级 */
.btn-delete {
  width: 100%;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--danger);
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--danger);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}
.btn-delete:active { opacity: 0.72; }
