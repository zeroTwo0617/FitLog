.legal-page { padding-top: 38rpx; padding-bottom: 36rpx; }
.legal-hero { padding-bottom: 26rpx; }
.legal-title { display: block; color: var(--text); font-size: 52rpx; font-weight: 900; line-height: 1.15; }
.legal-updated { display: block; margin-top: 14rpx; color: var(--text-dim); font-size: 21rpx; }
.legal-scroll { height: calc(100vh - 230rpx); }
.legal-section { padding: 26rpx 0 6rpx; border-top: 1rpx solid var(--hairline); }
.legal-section-title { display: block; color: var(--text); font-size: 29rpx; font-weight: 900; line-height: 1.35; }
.legal-paragraph { display: block; margin-top: 16rpx; color: var(--text-dim); font-size: 25rpx; line-height: 1.75; }
.legal-footer { padding: 32rpx 0 60rpx; color: var(--text-dim); font-size: 21rpx; line-height: 1.55; }
