/* 表单 */
.field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--card-border);
  margin-bottom: 20rpx;
}
.fl { font-size: 30rpx; color: var(--text-dim); }
.fv { font-size: 30rpx; font-weight: 600; color: var(--text); }

.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.g-item { width: calc(50% - 8rpx); display: flex; flex-direction: column; gap: 8rpx; }
.gl { font-size: 24rpx; color: var(--text-dim); }
.gi {
  background: var(--overlay);
  border: 1rpx solid var(--card-border);
  border-radius: 12rpx;
  padding: 0 16rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 30rpx;
  color: var(--text);
}
.note {
  margin-top: 18rpx;
  background: var(--overlay);
  border: 1rpx solid var(--card-border);
  border-radius: 12rpx;
  padding: 0 16rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 30rpx;
  color: var(--text);
}

.btn-save { margin-top: 24rpx; }

/* 体重趋势 */
.trend-card { padding-bottom: 16rpx; }
.trend-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.trend-caption { display: block; margin-top: 6rpx; color: var(--text-dim); font-size: 20rpx; }
.trend-latest { flex: 0 0 auto; text-align: right; }
.trend-latest > view { display: flex; align-items: baseline; justify-content: flex-end; }
.trend-latest-value { color: var(--text); font-size: 42rpx; font-weight: 900; line-height: 1; }
.trend-unit { margin-left: 4rpx; color: var(--text-dim); font-size: 20rpx; }
.trend-change { display: block; margin-top: 7rpx; font-size: 20rpx; font-weight: 800; }
.trend-change.down { color: var(--primary-strong); }
.trend-change.up { color: var(--danger); }
.trend-change.flat { color: var(--text-dim); }
.weight-chart-wrap { height: 300rpx; margin-top: 16rpx; padding: 0 2rpx; }
.weight-chart { display: block; width: 100%; height: 100%; }
.trend-foot { display: flex; justify-content: space-between; gap: 16rpx; margin-top: 3rpx; color: var(--text-dim); font-size: 20rpx; }

/* 历史列表 */
.rec { padding: 20rpx 0; border-bottom: 1rpx solid var(--hairline); }
.rec:last-child { border-bottom: none; }
.rec-date { font-size: 28rpx; font-weight: 600; color: var(--text); }
.rec-vals { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.rv {
  font-size: 24rpx; color: var(--text-dim);
  background: var(--inset);
  border-radius: 999rpx; padding: 6rpx 16rpx;
}
