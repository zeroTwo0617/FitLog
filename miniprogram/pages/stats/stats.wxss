.stats-page { padding-top: 24rpx; }
.eyebrow { display: block; margin-bottom: 12rpx; color: var(--primary); font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }
.stats-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-bottom: 22rpx; }
.stats-summary view { padding: 18rpx 16rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); }
.stats-summary view:first-child { border-color: rgba(198, 242, 78, 0.3); background: var(--primary-soft); }
.stats-summary view:first-child text:first-child { color: var(--primary); }
.stats-summary text { display: block; }
.stats-summary text:first-child { color: var(--text); font-size: 31rpx; font-weight: 750; }
.stats-summary text:last-child { margin-top: 7rpx; color: var(--text-dim); font-size: 20rpx; }
.stats-section { margin-bottom: 16rpx; padding: 20rpx 16rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-card); }
.stats-section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18rpx; }
.stats-section-head text:first-child { color: var(--text); font-size: 28rpx; font-weight: 700; }
.stats-section-head text:last-child { color: var(--text-dim); font-size: 20rpx; }
.trend-canvas { display: block; width: 100%; height: 190px; }
.chart-axis-title { margin: -8rpx 0 8rpx 54rpx; color: var(--text-dim); font-size: 20rpx; }
.chart-axis-caption { display: block; margin: 2px 4rpx 0 54rpx; color: var(--text-dim); font-size: 20rpx; text-align: right; }
.volume-chart { display: flex; align-items: flex-start; gap: 8rpx; height: 180px; padding: 0 4rpx; box-sizing: border-box; }
.volume-y-labels { display: flex; flex-direction: column; justify-content: space-between; width: 46rpx; height: 151px; color: var(--text-dim); font-size: 20rpx; line-height: 1; text-align: right; }
.volume-plot { min-width: 0; flex: 1; }
.volume-bars { position: relative; display: flex; align-items: flex-end; height: 151px; border-bottom: 1rpx solid var(--card-border); }
.volume-grid-line { position: absolute; left: 0; right: 0; height: 1rpx; background: rgba(126, 138, 129, 0.16); }
.grid-top { top: 0; }
.grid-mid-top { top: 33.33%; }
.grid-mid-bottom { top: 66.66%; }
.grid-bottom { bottom: 0; }
.volume-column { position: relative; z-index: 1; display: flex; align-items: flex-end; justify-content: center; width: 7.14%; height: 100%; }
.volume-bar { width: 20rpx; min-height: 0; border-radius: 5rpx 5rpx 0 0; background: var(--surface-2); }
.volume-bar-on { min-height: 6rpx; background: var(--primary); box-shadow: 0 0 10rpx rgba(198, 242, 78, 0.2); }
.volume-labels { display: flex; height: 27px; }
.volume-label-cell { width: 7.14%; color: var(--text-dim); font-size: 20rpx; text-align: center; }
.volume-label-cell text { display: block; padding-top: 7px; }
.orm-chips { margin-bottom: 14rpx; white-space: nowrap; }
.chart-hint { display: block; margin: -4rpx 0 10rpx; color: var(--text-dim); font-size: 19rpx; }
.max-list { display: flex; flex-direction: column; gap: 14rpx; }
.max-row { display: flex; align-items: center; gap: 10rpx; }
.max-name { width: 150rpx; overflow: hidden; color: var(--text); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.max-track { flex: 1; height: 12rpx; overflow: hidden; border-radius: 999rpx; background: var(--surface-2); }
.max-bar { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #9fd42f, var(--primary)); }
.max-value { width: 88rpx; color: var(--primary); font-size: 19rpx; font-weight: 700; text-align: right; }
.stats-link { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 4rpx; padding: 20rpx 16rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius); background: var(--surface); }
.stats-link text { display: block; }
.stats-link text:first-child { color: var(--text); font-size: 27rpx; font-weight: 700; }
.stats-link text:last-child { color: var(--text-dim); font-size: 20rpx; }
.stats-link view text:last-child { margin-top: 6rpx; color: var(--text-dim); font-size: 20rpx; font-weight: 400; }
