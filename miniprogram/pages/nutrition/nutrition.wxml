<view class="page nutrition-page theme-{{theme ? theme : 'dark'}}">
  <view class="nutrition-header"><view><text class="eyebrow">NUTRITION LOG</text><text class="h-title">饮食记录</text><text class="h-sub">按天记录营养，让训练和饮食放在一起</text></view><picker mode="date" value="{{date}}" bindchange="onDate"><view class="date-picker">{{date}}</view></picker></view>

  <view class="daily-card"><view class="daily-head"><view><text class="daily-kicker">DAILY TOTAL</text><text class="daily-calories">{{summary.calories}} <text>kcal</text></text></view><text class="daily-target">目标 {{dailyTargetCalories || '未设置'}}</text></view><view class="macro-summary"><view><text>{{summary.protein}}g</text><text>蛋白质</text></view><view><text>{{summary.carbs}}g</text><text>碳水</text></view><view><text>{{summary.fat}}g</text><text>脂肪</text></view></view></view>

  <view class="section-head"><text class="section-title">{{summary.mealCount}} 餐记录</text><button class="add-button" bindtap="newMeal">＋ 添加</button></view>
  <view class="loading" wx:if="{{loading}}">正在加载饮食记录</view>
  <view class="meal-list" wx:if="{{!loading && records.length > 0}}"><view class="meal-row" wx:for="{{records}}" wx:key="_id" bindtap="editMeal" data-id="{{item._id}}"><view class="meal-mark">{{item.mealTypeLabel}}</view><view class="meal-copy"><text>{{item.mealTypeLabel}}</text><text>{{item.note || '手动记录'}} · {{item.protein}}g 蛋白质 · {{item.carbs}}g 碳水 · {{item.fat}}g 脂肪</text></view><view class="meal-calories"><text>{{item.calories}}</text><text>kcal</text></view><text class="meal-arrow">→</text></view></view>
  <view class="empty" wx:if="{{!loading && records.length === 0}}"><text class="empty-text">这天还没有饮食记录</text><text class="empty-sub">从一餐开始，热量会按宏量营养素自动换算</text><button class="btn-primary empty-add" bindtap="newMeal">添加第一餐</button></view>
  <view class="error-note" wx:if="{{error}}">{{error}}</view>

  <view class="editor-mask" wx:if="{{editor}}"><view class="editor-sheet" catchtap="noop"><view class="sheet-handle"></view><view class="editor-head"><view><text class="editor-kicker">{{editingId ? 'EDIT MEAL' : 'NEW MEAL'}}</text><text class="editor-title">{{editingId ? '修改饮食' : '添加饮食'}}</text></view><text class="editor-close" bindtap="closeEditor">×</text></view><picker mode="selector" range="{{mealTypes}}" range-key="label" value="{{mealTypeIndex}}" bindchange="onMealType"><view class="meal-type-picker"><text>餐次</text><text>{{editor.mealLabel}} · {{date}} →</text></view></picker><view class="editor-grid"><view class="editor-field"><text>蛋白质 g</text><input type="digit" value="{{editor.protein}}" data-field="protein" bindinput="onField" /></view><view class="editor-field"><text>碳水 g</text><input type="digit" value="{{editor.carbs}}" data-field="carbs" bindinput="onField" /></view><view class="editor-field"><text>脂肪 g</text><input type="digit" value="{{editor.fat}}" data-field="fat" bindinput="onField" /></view><view class="calorie-field"><text>自动热量</text><text>{{editor.calories}} kcal</text></view></view><text class="formula-note">蛋白质 × 4 + 碳水 × 4 + 脂肪 × 9</text><input class="note-input" value="{{editor.note}}" bindinput="onNote" placeholder="备注，例如：训练后加餐" /><view class="editor-actions"><button class="delete-button" wx:if="{{editingId}}" bindtap="removeMeal">删除</button><button class="btn-primary" bindtap="save" disabled="{{saving}}">{{saving ? '保存中…' : '保存记录'}}</button></view></view></view>
</view>
