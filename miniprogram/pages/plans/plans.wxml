<view class="page tab-page plans-page theme-{{theme ? theme : 'dark'}}">
  <view wx:if="{{loading}}" class="loading-banner">正在加载计划...</view>
  <view class="plans-header"><view><text class="eyebrow">WORKOUT PLANS</text><text class="h-title">训练计划</text><text class="h-sub">把常练动作整理好，记录时直接开始</text></view></view>
  <view class="plans-summary"><view><text>{{list.length}}</text><text>个计划</text></view><view><text>{{totalExercises}}</text><text>个动作</text></view><view><text>{{list.length > 0 ? 'Ready' : 'Empty'}}</text><text>当前状态</text></view></view>
  <view class="plans-list" wx:if="{{list.length > 0}}"><view class="plan-item" wx:for="{{list}}" wx:key="_id" bindtap="goDetail" data-id="{{item._id}}"><view class="plan-item-head"><view><text class="plan-item-name">{{item.name}}</text><text class="plan-item-meta">{{item.count}} 个动作 · {{item.totalSets || item.count}} 组目标</text></view><text class="plan-item-arrow">→</text></view><view class="chip-row" wx:if="{{item.previewNames.length > 0}}"><text class="tag" wx:for="{{item.previewNames}}" wx:key="*this">{{item}}</text><text class="tag dim" wx:if="{{item.moreCount > 0}}">+{{item.moreCount}}</text></view><text class="plan-item-desc">{{item.namesText}}</text></view></view>
  <view class="empty" wx:if="{{list.length === 0 && !loading}}"><text class="empty-text">还没有训练计划</text><text class="empty-sub">创建一套常练组合，记录训练会更快</text></view>
  <button class="btn-primary create-plan" bindtap="goCreate">新建训练计划</button>
</view>
