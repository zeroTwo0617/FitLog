.plans-page { padding-top: 24rpx; padding-bottom: calc(156rpx + env(safe-area-inset-bottom)); }
.loading-banner { margin-bottom: 16rpx; padding: 14rpx 18rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); color: var(--text-dim); font-size: 23rpx; text-align: center; }
.plans-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 22rpx; }
.eyebrow { display: block; margin-bottom: 12rpx; color: var(--primary); font-size: 22rpx; font-weight: 750; letter-spacing: 2rpx; }
.plans-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-bottom: 24rpx; }
.plans-summary view { padding: 16rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); }
.plans-summary text { display: block; }
.plans-summary text:first-child { color: var(--text); font-size: 33rpx; font-weight: 750; }
.plans-summary text:last-child { margin-top: 7rpx; color: var(--text-dim); font-size: 22rpx; }
.plans-list { border-top: 1rpx solid var(--card-border); }
.plan-item { padding: 20rpx 0; border-bottom: 1rpx solid var(--card-border); }
.plan-item-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.plan-item-name { display: block; color: var(--text); font-size: 31rpx; font-weight: 700; }
.plan-item-meta { display: block; margin-top: 7rpx; color: var(--text-dim); font-size: 22rpx; }
.plan-item-arrow { color: var(--text-dim); font-size: 28rpx; }
.chip-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 15rpx; }
.chip-row .tag { margin: 0; }
.plan-item-desc { display: block; margin-top: 12rpx; overflow: hidden; color: var(--text-dim); font-size: 22rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.create-plan { position: fixed; right: 32rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); left: 32rpx; z-index: 90; width: auto; margin: 0; }
