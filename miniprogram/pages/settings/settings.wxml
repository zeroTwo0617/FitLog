<view class="page settings-page theme-{{theme}}">
  <view class="settings-hero">
    <text class="eyebrow">PREFERENCES</text>
    <text class="settings-title">设置</text>
    <text class="settings-subtitle">让 FitLog 按你的节奏工作。</text>
  </view>

  <view class="settings-section">
    <text class="section-label">外观</text>
    <view class="settings-card">
      <view class="settings-row">
        <view class="settings-row-icon plain-icon"><image src="/assets/icons/settings{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit" /></view>
        <view class="settings-row-copy"><text class="settings-row-title">黑色主题</text><text class="settings-row-note">切换深色背景和低亮度界面</text></view>
        <switch checked="{{darkMode}}" color="#c4e63b" bindchange="toggleDarkTheme" />
      </view>
    </view>
  </view>

  <view class="settings-section">
    <text class="section-label">数据与隐私</text>
    <view class="settings-card settings-links">
      <view class="settings-row settings-link-row" bindtap="openLegal" data-type="privacy">
        <view class="settings-row-copy"><text class="settings-row-title">隐私政策</text><text class="settings-row-note">了解我们收集、使用和保护数据的方式</text></view>
        <text class="settings-row-arrow">›</text>
      </view>
      <view class="settings-row settings-link-row" bindtap="openLegal" data-type="health">
        <view class="settings-row-copy"><text class="settings-row-title">健康数据说明</text><text class="settings-row-note">了解训练、身体和饮食数据的用途</text></view>
        <text class="settings-row-arrow">›</text>
      </view>
      <view class="settings-row settings-link-row" bindtap="openLegal" data-type="image">
        <view class="settings-row-copy"><text class="settings-row-title">图片上传说明</text><text class="settings-row-note">了解饮食图片的上传、识别和删除流程</text></view>
        <text class="settings-row-arrow">›</text>
      </view>
      <view class="settings-row settings-link-row danger-row" bindtap="deleteUserData" aria-disabled="{{deleting}}">
        <view class="settings-row-copy"><text class="settings-row-title">{{deleting ? '正在删除数据…' : '删除我的数据'}}</text><text class="settings-row-note">永久删除当前账号下的全部数据</text></view>
        <text class="settings-row-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="settings-tip"><text>主题会自动保存，下次打开小程序继续使用。</text></view>
</view>
