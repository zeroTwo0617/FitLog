.exercises-page { display: flex; height: 100vh; flex-direction: column; overflow: hidden; padding-top: 28rpx; padding-bottom: 0; }
.brand-mark { display: block; color: var(--text); font-size: 20rpx; font-weight: 900; letter-spacing: 3rpx; }
.exercises-header { flex: 0 0 auto; margin-bottom: 18rpx; }
.search-box { display: flex; align-items: center; gap: 8rpx; flex: 0 0 auto; padding: 0 14rpx; border: 1rpx solid var(--border); border-radius: 10rpx; background: var(--card-bg); }
.search-mark { flex: 0 0 auto; color: var(--text-dim); font-size: 31rpx; line-height: 1; }
.search-input { flex: 1; border: 0; background: transparent; }
.cat-chips { flex: 0 0 auto; margin-top: 14rpx; padding-bottom: 3rpx; white-space: nowrap; }
.cat-chips .chip { display: inline-block; }
.chip-count { color: inherit; font-size: 17rpx; font-weight: 600; }
.library-toolbar { display: flex; align-items: center; justify-content: space-between; flex: 0 0 auto; margin: 17rpx 0 8rpx; color: var(--text-dim); font-size: 19rpx; }
.exercise-list-scroll { flex: 1; width: 100%; min-height: 0; }
.exercise-list { border-top: 1rpx solid var(--border); padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }
.exercise-row { display: grid; grid-template-columns: 34rpx minmax(0, 1fr) auto 24rpx; align-items: center; gap: 10rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--hairline); }
.exercise-row:active { opacity: .62; }
.exercise-index { color: var(--placeholder); font-size: 17rpx; }
.exercise-main { min-width: 0; }
.exercise-name, .exercise-en, .exercise-meta-line { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.exercise-name { color: var(--text); font-size: 24rpx; font-weight: 900; }
.exercise-en { margin-top: 4rpx; color: var(--text-dim); font-size: 17rpx; }
.exercise-meta-line { margin-top: 6rpx; color: var(--text-dim); font-size: 17rpx; }
.exercise-meta-line text { display: inline; }
.meta-divider { margin: 0 6rpx; color: var(--border); }
.exercise-tag { max-width: 100rpx; padding: 6rpx 8rpx; border-radius: 6rpx; background: var(--primary-soft); color: var(--primary-strong); font-size: 16rpx; font-weight: 800; text-align: center; }
.exercise-arrow { color: var(--text-dim); font-size: 33rpx; font-weight: 300; line-height: 1; }
.list-end { padding: 18rpx 0 36rpx; color: var(--text-dim); font-size: 17rpx; text-align: center; }
