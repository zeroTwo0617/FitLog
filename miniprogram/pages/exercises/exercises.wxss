.exercises-page { display: flex; height: 100vh; flex-direction: column; overflow: hidden; padding-top: 24rpx; padding-bottom: 0; }
.exercises-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.eyebrow { display: block; margin-bottom: 12rpx; color: var(--primary); font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }
.result-total { display: flex; flex: none; flex-direction: column; align-items: flex-end; padding-top: 24rpx; color: var(--text-dim); font-size: 20rpx; }
.result-total text:first-child { color: var(--primary); font-size: 35rpx; font-weight: 750; line-height: 1; }
.result-total text:last-child { margin-top: 6rpx; }
.search-box { flex: none; }

/* 顶部胶囊分类栏：拇指可达，纵向空间还给内容 */
.cat-chips { flex: none; margin-top: 16rpx; padding-bottom: 4rpx; white-space: nowrap; }
.cat-chips .chip { display: inline-flex; }

/* 双列卡片网格：一屏信息量翻倍，首字色块四色轮换 */
.exercise-grid-scroll { flex: 1; width: 100%; min-height: 0; margin-top: 14rpx; box-sizing: border-box; }
.ex-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.ex-card { min-width: 0; padding: 16rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); }
.ex-card:active { opacity: 0.72; }
.ex-tile { display: flex; align-items: center; justify-content: center; width: 100%; height: 148rpx; margin-bottom: 14rpx; border-radius: 14rpx; font-size: 46rpx; font-weight: 800; }
.tile-0 { background: linear-gradient(135deg, rgba(198, 242, 78, 0.2), rgba(198, 242, 78, 0.05)); color: var(--primary); }
.tile-1 { background: linear-gradient(135deg, rgba(255, 122, 69, 0.18), rgba(255, 122, 69, 0.05)); color: var(--accent); }
.tile-2 { background: linear-gradient(135deg, rgba(91, 200, 175, 0.18), rgba(91, 200, 175, 0.05)); color: var(--teal); }
.tile-3 { background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03)); color: var(--text); }
.theme-light .tile-3 { background: linear-gradient(135deg, rgba(23, 29, 20, 0.08), rgba(23, 29, 20, 0.03)); }
.ex-name { display: block; overflow: hidden; color: var(--text); font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.ex-en { display: block; margin-top: 4rpx; overflow: hidden; color: var(--placeholder); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.ex-tags { display: flex; align-items: center; gap: 8rpx; margin-top: 12rpx; }
.ex-tags text { padding: 5rpx 10rpx; border-radius: 8rpx; background: var(--surface-2); color: var(--text-dim); font-size: 18rpx; }
.ex-tags text.hot { background: var(--primary-soft); color: var(--primary); font-weight: 650; }
.list-end { padding: 20rpx 0 40rpx; color: var(--text-dim); font-size: 19rpx; text-align: center; }
