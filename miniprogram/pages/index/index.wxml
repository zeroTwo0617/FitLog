<view class="page tab-page home theme-{{theme ? theme : 'light'}}">
  <view wx:if="{{loading}}" class="loading-banner">正在同步训练数据...</view>

  <view class="home-header">
    <view>
      <text class="brand-mark">FITLOG</text>
      <text class="home-title">今天，练什么？</text>
      <view class="date-line"><text class="date-dot">●</text><text>{{todayText}}</text><text class="date-divider">/</text><text>保持节奏</text></view>
    </view>
  </view>

  <view class="focus-panel">
    <view class="focus-copy">
      <view class="section-kicker"><text class="accent-mark"></text><text>今日训练焦点</text></view>
      <text class="focus-title">把一次训练记下来</text>
      <text class="focus-description">{{heroNote}}</text>
      <view class="focus-meta"><text>{{todayText}}</text><text>{{weekDone}} / 7 天已完成</text></view>
      <button class="primary-button" bindtap="goRecord"><text>开始训练</text><text class="button-symbol">→</text></button>
    </view>
    <view class="progress-ring"><view class="progress-inner"><text class="progress-value">{{weekDone}}</text><text>/7</text><text class="progress-caption">本周完成</text></view></view>
  </view>

  <view class="metric-strip">
    <view class="metric" wx:for="{{stats}}" wx:key="label"><text class="metric-icon {{index === 0 ? 'lime' : (index === 1 ? 'orange' : 'rust')}}">{{index === 0 ? '◆' : (index === 1 ? '□' : '↗')}}</text><text class="metric-label">{{item.label}}</text><text class="metric-value">{{item.value}}</text><text class="metric-note">{{item.note}}</text></view>
  </view>

  <view class="metric-strip energy-strip" bindtap="goBody">
    <view class="metric energy-metric"><text class="metric-icon lime">◌</text><text class="metric-label">基础代谢</text><text class="metric-value">{{energySummary.bmr}}</text><text class="metric-note">kcal · 估算</text></view>
    <view class="metric energy-metric"><text class="metric-icon orange">▲</text><text class="metric-label">运动消耗</text><text class="metric-value">{{energySummary.exercise}}</text><text class="metric-note">kcal · 今日</text></view>
    <view class="metric energy-metric"><text class="metric-icon rust">+</text><text class="metric-label">总消耗</text><text class="metric-value">{{energySummary.total}}</text><text class="metric-note">kcal · 查看身体数据</text></view>
  </view>
  <text class="energy-note">{{energySummary.note}}</text>

  <view class="next-section">
    <view class="section-heading"><text class="section-title">接下来</text><text class="section-meta">快速进入</text></view>
    <view class="action-list">
      <view class="action-row" bindtap="goPlans"><view class="row-icon lime-icon">□</view><view class="row-copy"><text class="row-title">训练计划</text><text class="row-sub">整理常练动作与下一次安排</text></view><text class="row-arrow">›</text></view>
      <view class="action-row" bindtap="goAgent"><view class="row-icon rust-icon">✦</view><view class="row-copy"><text class="row-title">训练助手</text><text class="row-sub">让线上教练结合你的训练记录给建议</text></view><text class="row-arrow">›</text></view>
      <view class="action-row" bindtap="goNutrition"><view class="row-icon orange-icon">◉</view><view class="row-copy"><text class="row-title">今日饮食</text><text class="row-sub">{{todayNutritionText}} · {{todayNutritionMeta}}</text></view><text class="row-arrow">›</text></view>
      <view class="action-row" bindtap="goHistory"><view class="row-icon plain-icon">↗</view><view class="row-copy"><text class="row-title">训练历史</text><text class="row-sub">回看每次训练，找到自己的进步</text></view><text class="row-arrow">›</text></view>
    </view>
  </view>

  <view class="section" wx:if="{{recentPlans.length > 0}}">
    <view class="section-head"><text class="section-title">最近计划</text><text class="section-meta">{{recentPlans.length}} 个</text></view>
    <view class="plan-list"><view class="plan-row" wx:for="{{recentPlans}}" wx:key="_id" bindtap="openPlan" data-id="{{item._id}}"><view class="row-copy"><text class="plan-name">{{item.name}}</text><text class="plan-preview">{{item.preview}}</text></view><text class="plan-count">{{item.count}}<text> 动作</text></text><text class="row-arrow">›</text></view></view>
  </view>
</view>
