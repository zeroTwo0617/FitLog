<view class="page tab-page home theme-{{theme ? theme : 'light'}}">
  <view wx:if="{{loading}}" class="loading-banner">正在同步训练数据...</view>

  <view class="home-header">
    <view>
      <text class="brand-mark">FITLOG</text>
      <text class="home-title">今天，练什么？</text>
      <view class="date-line"><text class="date-dot">●</text><text>{{todayText}}</text><text class="date-divider">/</text><text>保持节奏</text></view>
    </view>
  </view>

  <view class="focus-panel">
    <view class="focus-copy">
      <view class="section-kicker"><text class="accent-mark"></text><text>今日训练焦点</text></view>
      <text class="focus-title">把一次训练记下来</text>
      <text class="focus-description">{{heroNote}}</text>
      <view class="focus-meta"><text>{{todayText}}</text><text>{{weekDone}} / 7 天已完成</text></view>
      <button class="primary-button" bindtap="goRecord"><text>开始训练</text><text class="button-symbol">→</text></button>
    </view>
    <view class="progress-ring" style="{{progressStyle}}"><view class="progress-inner"><view class="progress-value-row"><text class="progress-value">{{weekDone}}</text><text>/7</text></view><text class="progress-caption">本周完成</text></view></view>
  </view>

  <view class="metric-strip">
    <view class="metric" wx:for="{{stats}}" wx:key="label"><image class="metric-icon" mode="aspectFit" src="/assets/icons/{{index === 0 ? 'dumbbell' : (index === 1 ? 'clipboard-list' : 'chart-column-increasing')}}{{theme === 'light' ? '-light' : ''}}.svg" /><text class="metric-label">{{item.label}}</text><text class="metric-value">{{item.value}}</text><text class="metric-note">{{item.note}}</text></view>
  </view>

  <view class="metric-strip energy-strip" bindtap="goBody">
    <view class="metric energy-metric"><image class="metric-icon" mode="aspectFit" src="/assets/icons/flame{{theme === 'light' ? '-light' : ''}}.svg" /><text class="metric-label">基础代谢</text><text class="metric-value">{{energySummary.bmr}}</text><text class="metric-note">kcal · 估算</text></view>
    <view class="metric energy-metric"><image class="metric-icon" mode="aspectFit" src="/assets/icons/activity{{theme === 'light' ? '-light' : ''}}.svg" /><text class="metric-label">运动消耗</text><text class="metric-value">{{energySummary.exercise}}</text><text class="metric-note">kcal · 今日</text></view>
    <view class="metric energy-metric"><image class="metric-icon" mode="aspectFit" src="/assets/icons/zap{{theme === 'light' ? '-light' : ''}}.svg" /><text class="metric-label">总消耗</text><text class="metric-value">{{energySummary.total}}</text><text class="metric-note">kcal · 查看身体数据</text></view>
  </view>
  <text class="energy-note">{{energySummary.note}}</text>

  <view class="next-section">
    <view class="section-heading"><text class="section-title">更多记录</text><text class="section-meta">回看训练</text></view>
    <view class="action-list">
      <view class="action-row" bindtap="goHistory"><view class="row-icon plain-icon"><image class="row-icon-image" mode="aspectFit" src="/assets/icons/history{{theme === 'light' ? '-light' : ''}}.svg" /></view><view class="row-copy"><text class="row-title">训练历史</text><text class="row-sub">回看每次训练，找到自己的进步</text></view><text class="row-arrow">›</text></view>
    </view>
  </view>

  <view class="quick-actions">
    <button class="quick-action quick-action-plan" bindtap="goPlans"><image mode="aspectFit" src="/assets/icons/clipboard-list{{theme === 'light' ? '-light' : ''}}.svg" /><text>训练计划</text></button>
    <button class="quick-action quick-action-diet" bindtap="goNutrition"><image mode="aspectFit" src="/assets/icons/utensils{{theme === 'light' ? '-light' : ''}}.svg" /><text>饮食</text></button>
  </view>

</view>
