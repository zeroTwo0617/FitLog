<view class="page tab-page home theme-{{theme ? theme : 'dark'}}">
  <view wx:if="{{loading}}" class="loading-banner">正在同步训练数据...</view>
  <view class="home-header">
    <view>
      <text class="eyebrow">FITLOG / 训练工作台</text>
      <text class="home-title">今天，练什么？</text>
      <text class="home-date">{{todayText}}</text>
    </view>
    <view class="avatar-mark">FL</view>
  </view>

  <view class="start-panel">
    <view class="start-copy">
      <text class="start-kicker">TODAY'S SESSION</text>
      <text class="start-title">把一次训练记下来</text>
      <text class="start-note">{{heroNote}}</text>
    </view>
    <button class="start-button" bindtap="goRecord">开始训练 <text>→</text></button>
  </view>

  <view class="week-strip" wx:if="{{weekDays.length > 0}}">
    <view class="week-head"><text class="week-title">本周打卡</text><text class="week-meta">{{weekDone}} / 7 天</text></view>
    <view class="week-days">
      <view class="wd {{item.trained ? 'done' : ''}} {{item.isToday ? 'today' : ''}}" wx:for="{{weekDays}}" wx:key="dateStr">
        <view class="wd-cell">{{item.trained ? '✓' : (item.isToday ? '今' : '·')}}</view>
        <text class="wd-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="section overview-section">
    <view class="section-head">
      <text class="section-title">训练概览</text>
      <text class="section-meta">累计数据</text>
    </view>
    <view class="overview-grid">
      <view class="overview-item" wx:for="{{stats}}" wx:key="label">
        <text class="overview-value {{index === 0 ? 'value-accent' : ''}}">{{item.value}}</text>
        <text class="overview-label">{{item.label}}</text>
        <text class="overview-note">{{item.note}}</text>
      </view>
    </view>
  </view>

  <view class="nutrition-snapshot" bindtap="goNutrition">
    <view class="nutrition-snapshot-mark">营</view>
    <view class="nutrition-snapshot-copy">
      <text class="nutrition-snapshot-title">今日饮食</text>
      <text class="nutrition-snapshot-main">{{todayNutritionText}}</text>
      <text class="nutrition-snapshot-meta">{{todayNutritionMeta}}</text>
    </view>
    <text class="nutrition-snapshot-arrow">→</text>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">常用入口</text>
      <text class="section-meta">快速到达</text>
    </view>
    <view class="quick-grid">
      <view class="quick-cell" bindtap="goPlans">
        <view class="quick-ic qi-volt"><image src="/assets/icons/quick-plan.svg" mode="aspectFit" /></view>
        <view class="quick-copy"><text>训练计划</text><text>整理常练动作</text></view>
      </view>
      <view class="quick-cell" bindtap="goHistory">
        <view class="quick-ic qi-orange"><image src="/assets/icons/quick-history.svg" mode="aspectFit" /></view>
        <view class="quick-copy"><text>训练历史</text><text>回看每次训练</text></view>
      </view>
      <view class="quick-cell" bindtap="goStats">
        <view class="quick-ic qi-teal"><image src="/assets/icons/quick-stats.svg" mode="aspectFit" /></view>
        <view class="quick-copy"><text>数据统计</text><text>趋势与 PR</text></view>
      </view>
      <view class="quick-cell" bindtap="goBody">
        <view class="quick-ic qi-plain"><image src="/assets/icons/quick-body.svg" mode="aspectFit" /></view>
        <view class="quick-copy"><text>身体数据</text><text>体重与围度</text></view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{recentPlans.length > 0}}">
    <view class="section-head"><text class="section-title">最近计划</text><text class="section-meta">{{recentPlans.length}} 个</text></view>
    <view class="plan-list">
      <view class="plan-row" wx:for="{{recentPlans}}" wx:key="_id" bindtap="openPlan" data-id="{{item._id}}">
        <view><text class="plan-name">{{item.name}}</text><text class="plan-preview">{{item.preview}}</text></view>
        <text class="plan-count">{{item.count}}<text> 动作</text></text>
      </view>
    </view>
  </view>
</view>
