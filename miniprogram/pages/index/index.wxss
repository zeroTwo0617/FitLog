.home { padding-top: 24rpx; }
.loading-banner { margin-bottom: 16rpx; padding: 14rpx 18rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); color: var(--text-dim); font-size: 21rpx; text-align: center; }
.home-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 28rpx; }
.eyebrow { display: block; color: var(--primary); font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }
.home-title { display: block; margin-top: 12rpx; color: var(--text); font-size: 54rpx; font-weight: 800; letter-spacing: 0; line-height: 1.1; }
.home-date { display: block; margin-top: 10rpx; color: var(--text-dim); font-size: 23rpx; }
.avatar-mark {
  display: flex; align-items: center; justify-content: center;
  width: 72rpx; height: 72rpx; border-radius: 22rpx;
  background: linear-gradient(135deg, var(--primary), #9fd42f);
  color: #12160a; font-size: 24rpx; font-weight: 800;
}

/* Hero：Volt 渐变大卡，「开始训练」第一视觉层级 */
.start-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 320rpx;
  padding: 32rpx 28rpx;
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: linear-gradient(128deg, #d9ff6b 0%, #b4ec45 45%, #7fcb2e 100%);
  color: #12160a;
  box-shadow: 0 16rpx 40rpx rgba(198, 242, 78, 0.22);
}
.start-panel::after {
  position: absolute; top: -120rpx; right: -90rpx;
  width: 380rpx; height: 380rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  content: '';
}
.start-panel::before {
  position: absolute; right: 60rpx; bottom: -170rpx;
  width: 300rpx; height: 300rpx; border-radius: 50%;
  border: 44rpx solid rgba(18, 22, 10, 0.1);
  content: '';
}
.start-copy { position: relative; z-index: 2; max-width: 560rpx; }
.start-kicker { display: block; color: rgba(18, 22, 10, 0.62); font-size: 20rpx; font-weight: 800; letter-spacing: 3rpx; }
.start-title { display: block; margin-top: 16rpx; font-size: 46rpx; font-weight: 800; letter-spacing: 0; line-height: 1.2; }
.start-note { display: block; margin-top: 12rpx; color: rgba(18, 22, 10, 0.68); font-size: 23rpx; line-height: 1.5; }
.start-button {
  position: relative; z-index: 2;
  align-self: flex-start;
  min-width: 240rpx; margin-top: 28rpx; padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: #12160a; color: var(--primary);
  font-size: 27rpx; font-weight: 800;
}
.start-button text { margin-left: 12rpx; font-size: 28rpx; }
.start-button:active { opacity: 0.85; }

/* 本周打卡条 */
.week-strip { margin-top: 20rpx; padding: 22rpx 20rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-card); }
.week-head { display: flex; align-items: baseline; justify-content: space-between; }
.week-title { color: var(--text); font-size: 26rpx; font-weight: 700; }
.week-meta { color: var(--text-dim); font-size: 20rpx; }
.week-days { display: flex; justify-content: space-between; margin-top: 18rpx; }
.wd { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.wd-cell { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; border: 1rpx solid var(--border); border-radius: 16rpx; background: var(--surface-2); color: var(--text-dim); font-size: 24rpx; font-weight: 700; }
.wd.done .wd-cell { border-color: var(--primary); background: var(--primary); color: #12160a; font-weight: 800; }
.wd.today .wd-cell { border: 2rpx solid var(--primary); background: var(--primary-soft); color: var(--primary); }
.wd.done.today .wd-cell { background: var(--primary); color: #12160a; }
.wd-label { color: var(--text-dim); font-size: 18rpx; }
.wd.today .wd-label { color: var(--primary); font-weight: 700; }

/* 概览数据卡 */
.overview-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.overview-item { min-height: 152rpx; padding: 22rpx 18rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); }
.overview-value { display: block; color: var(--text); font-size: 40rpx; font-weight: 800; line-height: 1; }
.value-accent { color: var(--primary); }
.overview-label { display: block; margin-top: 12rpx; color: var(--text); font-size: 22rpx; font-weight: 600; }
.overview-note { display: block; margin-top: 7rpx; color: var(--text-dim); font-size: 18rpx; line-height: 1.3; }

/* 饮食快照 */
.nutrition-snapshot { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; padding: 20rpx 18rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); }
.nutrition-snapshot:active { opacity: .72; }
.nutrition-snapshot-mark { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; flex: none; border-radius: 16rpx; background: var(--accent-soft); color: var(--accent); font-size: 24rpx; font-weight: 750; }
.nutrition-snapshot-copy { flex: 1; min-width: 0; }
.nutrition-snapshot-title, .nutrition-snapshot-main, .nutrition-snapshot-meta { display: block; }
.nutrition-snapshot-title { color: var(--text-dim); font-size: 19rpx; }
.nutrition-snapshot-main { margin-top: 3rpx; color: var(--text); font-size: 25rpx; font-weight: 700; }
.nutrition-snapshot-meta { overflow: hidden; margin-top: 4rpx; color: var(--text-dim); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.nutrition-snapshot-arrow { flex: none; color: var(--text-dim); font-size: 28rpx; }

/* 快捷入口 2×2 图标网格 / 最近计划 */
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.quick-cell { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 18rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); }
.quick-cell:active { opacity: 0.7; }
.quick-ic { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; flex: none; border-radius: 18rpx; }
.quick-ic image { width: 34rpx; height: 34rpx; }
.qi-volt { background: var(--primary-soft); }
.qi-orange { background: var(--accent-soft); }
.qi-teal { background: rgba(91, 200, 175, 0.12); }
.qi-plain { background: var(--surface-3); }
.quick-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 5rpx; }
.quick-copy text:first-child { color: var(--text); font-size: 26rpx; font-weight: 700; }
.quick-copy text:last-child { overflow: hidden; color: var(--text-dim); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }

.plan-list { border-top: 1rpx solid var(--card-border); }
.plan-row { display: flex; align-items: center; gap: 18rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--card-border); justify-content: space-between; }
.plan-row:active { opacity: 0.7; }
.plan-name { display: block; color: var(--text); font-size: 27rpx; font-weight: 650; }
.plan-preview { display: block; margin-top: 6rpx; color: var(--text-dim); font-size: 21rpx; }
.plan-count { flex: none; color: var(--primary); font-size: 28rpx; font-weight: 750; }
.plan-count text { color: var(--text-dim); font-size: 20rpx; font-weight: 400; }
