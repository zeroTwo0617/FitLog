.home { padding-top: 28rpx; }
.loading-banner { margin-bottom: 16rpx; padding: 12rpx 14rpx; border-bottom: 1rpx solid var(--hairline); color: var(--text-dim); font-size: 20rpx; text-align: center; }
.home-header { margin-bottom: 24rpx; }
.brand-mark { display: block; color: var(--text); font-size: 22rpx; font-weight: 900; letter-spacing: 4rpx; }
.home-title { display: block; margin-top: 18rpx; color: var(--text); font-size: 54rpx; font-weight: 900; line-height: 1.08; }
.date-line { display: flex; align-items: center; gap: 8rpx; margin-top: 12rpx; color: var(--text-dim); font-size: 21rpx; }
.date-dot { color: var(--primary-strong); font-size: 14rpx; }
.date-divider { color: var(--border); }
.focus-panel { display: grid; grid-template-columns: minmax(0, 1fr) 166rpx; align-items: center; gap: 18rpx; min-height: 320rpx; padding: 28rpx 22rpx; border: 1rpx solid var(--border); border-radius: var(--radius); background: var(--card-bg); }
.focus-copy { min-width: 0; }
.section-kicker { display: flex; align-items: center; gap: 9rpx; margin-bottom: 16rpx; color: var(--text-dim); font-size: 20rpx; font-weight: 800; }
.accent-mark { display: inline-block; width: 6rpx; height: 28rpx; flex: 0 0 auto; background: var(--primary); }
.focus-title { display: block; color: var(--text); font-size: 34rpx; font-weight: 900; line-height: 1.18; }
.focus-description { display: block; margin-top: 11rpx; color: var(--text-dim); font-size: 21rpx; line-height: 1.5; }
.focus-meta { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 16rpx 0 18rpx; color: var(--danger); font-size: 18rpx; font-weight: 800; }
.focus-meta text + text { padding-left: 10rpx; border-left: 1rpx solid var(--border); color: var(--text-dim); }
.primary-button { display: inline-flex; align-items: center; justify-content: center; gap: 10rpx; min-height: 76rpx; padding: 0 22rpx; border-radius: 10rpx; background: var(--primary); color: var(--on-primary); font-size: 23rpx; font-weight: 900; }
.button-symbol { font-size: 25rpx; }
.progress-ring { position: relative; display: flex; align-items: center; justify-content: center; width: 156rpx; height: 156rpx; padding: 12rpx; box-sizing: content-box; border-radius: 50%; background: var(--hairline); transform: rotate(-22deg); }
.progress-inner { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; box-sizing: border-box; border-radius: 50%; background: var(--card-bg); transform: rotate(22deg); }
.progress-value-row { display: flex; align-items: baseline; justify-content: center; line-height: 1; }
.progress-inner text { color: var(--text); font-size: 24rpx; font-weight: 900; }
.progress-inner .progress-value { font-size: 42rpx; }
.progress-inner .progress-caption { margin-top: 6rpx; color: var(--text-dim); font-size: 16rpx; line-height: 1.2; text-align: center; }
.metric-strip { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 14rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius); background: var(--card-bg); }
.metric { min-width: 0; padding: 17rpx 8rpx 15rpx; text-align: center; }
.metric + .metric { border-left: 1rpx solid var(--hairline); }
.metric-icon { display: block; width: 26rpx; height: 26rpx; margin: 0 auto 5rpx; }
.metric-label { display: block; color: var(--text-dim); font-size: 18rpx; }
.metric-value { display: block; margin-top: 7rpx; color: var(--text); font-size: 30rpx; font-weight: 900; line-height: 1; }
.metric-note { display: block; margin-top: 6rpx; overflow: hidden; color: var(--text-dim); font-size: 16rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.energy-strip { margin-top: 12rpx; }
.energy-strip:active { opacity: .72; }
.energy-note { display: block; margin: 9rpx 2rpx 0; color: var(--text-dim); font-size: 17rpx; line-height: 1.45; }
.next-section { margin-top: 32rpx; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 12rpx; margin-bottom: 13rpx; }
.action-list { border-top: 1rpx solid var(--border); }
.action-row { display: flex; align-items: center; gap: 13rpx; width: 100%; padding: 14rpx 0; border-bottom: 1rpx solid var(--hairline); text-align: left; }
.action-row:active { opacity: .64; }
.row-icon { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; flex: 0 0 auto; border-radius: 10rpx; }
.row-icon-image { width: 28rpx; height: 28rpx; }
.lime-icon { background: var(--primary-soft); color: var(--primary-strong); }
.orange-icon { background: var(--accent-soft); color: var(--accent); }
.rust-icon { background: #fbe9e3; color: var(--danger); }
.plain-icon { background: var(--surface-2); color: var(--text-dim); }
.row-copy { flex: 1; min-width: 0; }
.row-title, .row-sub { display: block; }
.row-title { overflow: hidden; color: var(--text); font-size: 24rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.row-sub { overflow: hidden; margin-top: 5rpx; color: var(--text-dim); font-size: 18rpx; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.row-arrow { flex: 0 0 auto; color: var(--text-dim); font-size: 35rpx; font-weight: 300; line-height: 1; }
