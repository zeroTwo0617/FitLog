<view class="page agent-page theme-{{theme}}">
  <view class="agent-head">
    <view>
      <text class="eyebrow">AI COACH</text>
      <text class="h-title">教练</text>
      <text class="h-sub">训练建议与饮食记录</text>
    </view>
    <button class="text-btn" bindtap="clearSession" disabled="{{sending}}">＋ 新会话</button>
  </view>

  <view class="mode-tabs">
    <view class="mode-tab {{mode === 'training' ? 'mode-on' : ''}}" data-mode="training" bindtap="switchMode">训练</view>
    <view class="mode-tab {{mode === 'diet' ? 'mode-on' : ''}}" data-mode="diet" bindtap="switchMode">饮食</view>
  </view>

  <view wx:if="{{loadingContext}}" class="context-note">正在同步云端数据...</view>
  <view wx:if="{{error}}" class="error-note">{{error}}</view>

  <block wx:if="{{mode === 'diet'}}">
    <view class="meal-tools">
      <view class="meal-context">
        <picker mode="date" value="{{mealDate}}" bindchange="onMealDate">
          <view class="tool-picker"><text class="tool-label">日期</text><text class="tool-value">{{mealDate}}</text><text class="tool-chevron">›</text></view>
        </picker>
        <picker mode="selector" range="{{mealTypes}}" range-key="label" value="{{mealTypeIndex}}" bindchange="onMealType">
          <view class="tool-picker"><text class="tool-label">餐次</text><text class="tool-value">{{mealTypeLabel}}</text><text class="tool-chevron">›</text></view>
        </picker>
      </view>
      <view class="meal-actions">
        <button class="meal-action meal-action-primary" bindtap="chooseMealImage" loading="{{mealAnalyzing}}" disabled="{{mealAnalyzing}}"><image src="/assets/icons/sparkles-active{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit"></image><text>拍照估算</text></button>
        <button class="meal-action" bindtap="createManualMeal" disabled="{{mealAnalyzing}}"><text class="meal-action-symbol">＋</text><text>手动记录</text></button>
        <button class="meal-action" bindtap="openNutrition"><image src="/assets/icons/calendar-days-active{{theme === 'light' ? '-light' : ''}}.svg" mode="aspectFit"></image><text>管理饮食</text></button>
      </view>
    </view>
  </block>

  <scroll-view class="messages" scroll-y="true" scroll-into-view="msg-{{messages.length - 1}}">
    <view wx:for="{{messages}}" wx:key="index" id="msg-{{index}}" class="message {{item.role}}">
      <view wx:if="{{item.role === 'assistant'}}" class="message-label">FITLOG</view>
      <view class="bubble">{{item.content}}</view>
    </view>
    <view wx:if="{{sending}}" class="typing"><view class="typing-dot"></view>正在整理...</view>

    <view wx:if="{{planDraft}}" class="draft card">
      <view class="draft-head">
        <view>
          <text class="draft-kicker">训练草案</text>
          <text class="draft-title">{{planDraft.name}}</text>
        </view>
        <text class="draft-count">{{planDraft.items.length}} 个动作</text>
      </view>
      <view wx:for="{{planDraft.items}}" wx:key="exerciseId" class="draft-item">
        <text class="draft-name">{{item.exerciseName}}</text>
        <text class="draft-meta">{{item.targetSets}} 组 × {{item.targetReps}} 次</text>
      </view>
      <button class="btn-primary" bindtap="saveDraft">确认并编辑训练计划</button>
    </view>

    <view wx:if="{{dietPlanDraft}}" class="draft card diet-plan">
      <view class="draft-head">
        <view>
          <text class="draft-kicker">饮食草案</text>
          <text class="draft-title">{{dietPlanDraft.name}}</text>
        </view>
        <text class="draft-count">{{dietPlanDraft.dailyTarget.calories}} kcal/天</text>
      </view>
      <view class="diet-targets">
        <view><text>热量</text><input type="digit" value="{{dietPlanDraft.dailyTarget.calories}}" data-field="calories" bindinput="onDietTarget" /></view>
        <view><text>蛋白质</text><input type="digit" value="{{dietPlanDraft.dailyTarget.protein}}" data-field="protein" bindinput="onDietTarget" /></view>
        <view><text>碳水</text><input type="digit" value="{{dietPlanDraft.dailyTarget.carbs}}" data-field="carbs" bindinput="onDietTarget" /></view>
        <view><text>脂肪</text><input type="digit" value="{{dietPlanDraft.dailyTarget.fat}}" data-field="fat" bindinput="onDietTarget" /></view>
      </view>
      <view wx:for="{{dietPlanDraft.meals}}" wx:key="name" class="draft-item">
        <view>
          <text class="draft-name">{{item.name}}</text>
          <text class="meal-foods">{{item.foods[0].name}}<text wx:if="{{item.foods.length > 1}}"> 等 {{item.foods.length}} 项</text></text>
        </view>
        <input class="diet-meal-calories" type="digit" value="{{item.calories}}" data-index="{{index}}" bindinput="onDietMealField" />
      </view>
      <button class="btn-primary" bindtap="saveDietPlan" disabled="{{dietPlanSaved}}">{{dietPlanSaved ? '已保存饮食计划' : '保存饮食计划'}}</button>
    </view>

    <view wx:if="{{mealDraft}}" class="meal-draft card">
      <view class="draft-head">
        <view>
          <text class="draft-kicker">待确认记录</text>
          <text class="draft-title">{{mealDraft.dateStr}} · {{mealDraft.mealLabel}}</text>
        </view>
        <text class="draft-count">估算值</text>
      </view>
      <view class="meal-fields">
        <view class="meal-field"><text>热量 kcal{{mealDraft.source === 'manual' ? ' · 自动' : ''}}</text><input type="digit" value="{{mealDraft.calories}}" data-field="calories" bindinput="onMealField" disabled="{{mealDraft.source === 'manual'}}" /></view>
        <view class="meal-field"><text>蛋白质 g</text><input type="digit" value="{{mealDraft.protein}}" data-field="protein" bindinput="onMealField" /></view>
        <view class="meal-field"><text>碳水 g</text><input type="digit" value="{{mealDraft.carbs}}" data-field="carbs" bindinput="onMealField" /></view>
        <view class="meal-field"><text>脂肪 g</text><input type="digit" value="{{mealDraft.fat}}" data-field="fat" bindinput="onMealField" /></view>
      </view>
      <text class="macro-note" wx:if="{{mealDraft.source === 'manual'}}">热量按蛋白质、碳水和脂肪自动换算</text>
      <view wx:for="{{mealDraft.foods}}" wx:key="index" class="food-row">
        <input class="food-name" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="onFoodField" />
        <input class="food-portion" value="{{item.portion}}" data-index="{{index}}" data-field="portion" bindinput="onFoodField" />
        <input class="food-calories" type="digit" value="{{item.calories}}" data-index="{{index}}" data-field="calories" bindinput="onFoodField" />
      </view>
      <text class="privacy-note">确认后只保存营养数据，原始图片会删除。</text>
      <button class="btn-primary" bindtap="saveMeal" loading="{{mealSaving}}" disabled="{{mealSaving}}">确认保存饮食记录</button>
    </view>
  </scroll-view>

  <view class="assistant-actions" wx:if="{{!sending && messages.length > 1}}">
    <button class="outline-btn" bindtap="retry">重试上一条</button>
  </view>

  <view class="composer">
    <input class="agent-input" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="send" maxlength="500" placeholder="{{mode === 'diet' ? '例如：我想减脂，安排三餐饮食' : '例如：安排一个 3 天增肌计划'}}" />
    <button wx:if="{{sending}}" class="btn-stop" bindtap="stop">停止</button>
    <button wx:else class="btn-send" bindtap="send" disabled="{{!input}}">↑</button>
  </view>
</view>
