.agent-page {
  height: 100vh;
  padding: 16rpx 36rpx calc(152rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.agent-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.eyebrow { display: block; margin-bottom: 10rpx; color: var(--primary); font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }

.text-btn {
  flex: none;
  min-width: 124rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(198, 242, 78, 0.35);
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.agent-status { display: flex; align-items: center; gap: 8rpx; flex: none; padding-top: 10rpx; color: var(--text-dim); font-size: 21rpx; }
.agent-status .status-dot { display: block; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--warn); }
.agent-status.status-online .status-dot { background: var(--success); }
.agent-status.status-checking .status-dot { background: var(--text-dim); }
.agent-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 12rpx; color: var(--text-dim); font-size: 20rpx; }
.agent-toolbar .text-btn { min-width: 132rpx; height: 52rpx; line-height: 52rpx; }

.context-note {
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: var(--surface-2);
  color: var(--text-dim);
  font-size: 22rpx;
}

.error-note {
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: 10rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 22rpx;
}

.messages {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 12rpx 0 24rpx;
  box-sizing: border-box;
}

.message {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.message.user { align-items: flex-end; }

.message-label {
  margin: 0 0 8rpx 8rpx;
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.bubble {
  max-width: 86%;
  padding: 20rpx 22rpx;
  border-radius: 6rpx 18rpx 18rpx 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  color: var(--text);
  font-size: 26rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  box-shadow: 0 4rpx 14rpx rgba(25, 35, 55, 0.04);
}

.message.user .bubble {
  border-radius: 18rpx 6rpx 18rpx 18rpx;
  background: linear-gradient(135deg, #d9ff6b, #9fd42f);
  border-color: transparent;
  color: #12160a;
  font-weight: 600;
}
.theme-light .message.user .bubble {
  background: linear-gradient(135deg, #d8f58a, #9fd44f);
}

.typing {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--text-dim);
  font-size: 24rpx;
  padding: 6rpx 0 24rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  animation: pulse 0.9s ease-in-out infinite alternate;
}

@keyframes pulse { from { opacity: 0.35; } to { opacity: 1; } }

.draft {
  margin: 4rpx 0 28rpx;
  padding: 24rpx;
  background: var(--surface);
  box-shadow: 0 8rpx 24rpx rgba(25, 35, 55, 0.06);
}

.draft-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.draft-kicker, .draft-title { display: block; }
.draft-kicker { color: var(--primary); font-size: 20rpx; font-weight: 700; }
.draft-title { margin-top: 6rpx; font-size: 32rpx; font-weight: 700; }
.draft-count, .draft-meta { color: var(--text-dim); font-size: 22rpx; }
.draft-item { display: flex; justify-content: space-between; gap: 12rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--hairline); }
.draft-name { flex: 1; min-width: 0; }
.draft .btn-primary { margin-top: 22rpx; }

.assistant-actions { padding: 0 0 16rpx; }
.outline-btn { width: 100%; height: 60rpx; padding: 0; border: 1rpx solid var(--border); border-radius: 8rpx; color: var(--text-dim); font-size: 22rpx; line-height: 60rpx; }
.outline-btn[disabled], .prompt-chip[disabled], .attach-button[disabled] { opacity: .45; }

.prompt-list { display: flex; gap: 10rpx; padding: 0 0 12rpx; overflow: hidden; }
.prompt-chip { flex: 0 0 auto; height: 54rpx; padding: 0 16rpx; border: 1rpx solid var(--border); border-radius: 999rpx; background: var(--surface-2); color: var(--text-dim); font-size: 20rpx; line-height: 54rpx; white-space: nowrap; }

.composer {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 18rpx;
  box-shadow: var(--shadow-card);
}

.attach-button { display: flex; align-items: center; justify-content: center; width: 68rpx !important; min-width: 68rpx; height: 84rpx; flex: 0 0 68rpx; border: 1rpx solid var(--border); border-radius: 14rpx; background: var(--surface-2); color: var(--text-dim); font-size: 34rpx; line-height: 1; }
.agent-input { flex: 1 1 auto; min-width: 0; height: 84rpx; box-sizing: border-box; line-height: 84rpx; padding: 0 20rpx; border: 1rpx solid var(--border); border-radius: 14rpx; background: var(--surface-2); color: var(--text); font-size: 24rpx; }
.agent-input[disabled] { color: var(--text-dim); opacity: .65; }
/* 小程序 button[disabled] 默认样式优先级极高（白底 #f7f7f7），必须 !important 压制 */
.btn-send, .btn-stop { display: flex; align-items: center; justify-content: center; width: 84rpx !important; min-width: 84rpx; max-width: 84rpx; height: 84rpx; box-sizing: border-box; flex: 0 0 84rpx; padding: 0; line-height: 1; border-radius: 14rpx; color: var(--on-primary) !important; background: var(--primary) !important; font-size: 34rpx; font-weight: 800; box-shadow: 0 6rpx 16rpx rgba(198, 242, 78, 0.25); }
.btn-send[disabled] { opacity: 1; color: var(--primary) !important; background: var(--primary-soft) !important; box-shadow: none; }
.btn-stop { background: var(--danger) !important; color: #fff !important; box-shadow: none; font-size: 23rpx; }
