/* 计划名称：外观由全局 .card 提供 */
.field { display: flex; flex-direction: column; gap: 14rpx; }
.label { font-size: 28rpx; color: var(--text-dim); }
.name-inp { font-size: 38rpx; font-weight: 600; color: var(--text); }

.sec-title { margin: 36rpx 4rpx 18rpx; font-size: 31rpx; font-weight: 600; color: var(--text-dim); }

.items { display: flex; flex-direction: column; gap: 18rpx; }
/* 动作项：外观由全局 .card 提供 */
.item-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.item-name { font-size: 35rpx; font-weight: 600; }
.item-del { font-size: 26rpx; color: var(--danger); }

.targets { display: flex; gap: 16rpx; }
.tg { flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.tg-label { display: block; height: 28rpx; color: var(--text-dim); font-size: 24rpx; line-height: 28rpx; white-space: nowrap; }
.tg-inp {
  display: block;
  width: 100%;
  height: 56rpx;
  box-sizing: border-box;
  background: var(--overlay);
  border: 1rpx solid var(--hairline);
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  line-height: 56rpx;
  text-align: center;
  color: var(--text);
}

.btn-add { margin-top: 28rpx; }

/* 动作选择器：底部弹出遮罩面板（fixed，保留模糊） */
.picker-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: var(--mask);
  z-index: 100;
  display: flex; flex-direction: column; justify-content: flex-end;
}
.sheet {
  background: var(--sheet-bg);
  border-radius: 16rpx 16rpx 0 0;
  border-top: 1rpx solid var(--hairline);
  padding: 8rpx 24rpx 24rpx;
  max-height: 82vh;
  display: flex; flex-direction: column;
  box-sizing: border-box;
}
.sheet-handle {
  width: 68rpx; height: 7rpx; border-radius: 999rpx;
  background: var(--hairline);
  margin: 10rpx auto 18rpx;
}
.search { margin-bottom: 16rpx; flex-shrink: 0; }
.cats { white-space: nowrap; margin-bottom: 16rpx; flex-shrink: 0; }
.pick-list { max-height: 56vh; flex: 1; }
.pick-item { display: flex; flex-direction: column; gap: 6rpx; padding: 22rpx 8rpx; border-bottom: 1rpx solid var(--hairline); }
.pick-item:active { background: var(--surface-2); }
.pick-name { font-size: 32rpx; }
.pick-meta { font-size: 24rpx; color: var(--text-dim); }

.btn-save { margin-top: 36rpx; }
