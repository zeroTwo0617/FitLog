.tabbar-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding: 0 20rpx calc(12rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tabbar {
  display: flex;
  height: 148rpx;
  padding: 10rpx 12rpx 16rpx;
  border: 1rpx solid var(--card-border);
  border-radius: 48rpx;
  background-color: #181d19;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(14px);
  pointer-events: auto;
}

.theme-light.tabbar {
  background-color: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(21, 42, 35, 0.08);
}

.tab {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  min-width: 0;
  border-radius: 24rpx;
  color: var(--text-dim);
}

.tab.active {
  color: var(--primary);
}

.tab-icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
}

.tab.active .tab-icon {
  transform: translateY(-2rpx);
}

.tab-label {
  overflow: hidden;
  max-width: 100%;
  color: currentColor;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab.active .tab-label {
  color: var(--primary);
  font-weight: 750;
}

/* 选中态下方 Volt 小圆点 */
.tab::after {
  width: 6rpx;
  height: 6rpx;
  margin-top: 1rpx;
  border-radius: 50%;
  background: transparent;
  content: '';
}

.tab.active::after { background: var(--primary); }
