.tabbar-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
  pointer-events: none;
}

.tabbar {
  display: flex;
  height: 112rpx;
  padding: 8rpx 10rpx 10rpx;
  border-top: 1rpx solid #d9ddd4;
  background: #f8f9f6;
  box-shadow: 0 -8rpx 24rpx rgba(28, 35, 27, 0.07);
  pointer-events: auto;
}

.tab {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  min-width: 0;
  color: #8b9388;
}

.tab.active { color: #6e8f00; }
.tab.active::before { position: absolute; top: -8rpx; width: 42rpx; height: 4rpx; border-radius: 0 0 4rpx 4rpx; background: #b4dc16; content: ''; }
.tab-icon { display: block; width: 40rpx; height: 40rpx; }
.tab.active .tab-icon { transform: translateY(-1rpx); }
.tab-label { overflow: hidden; max-width: 100%; color: currentColor; font-size: 18rpx; font-weight: 700; line-height: 1; text-overflow: ellipsis; white-space: nowrap; }
.tab.active .tab-label { font-weight: 900; }
