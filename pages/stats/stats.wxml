<view class="page tab-page theme-{{theme ? theme : 'dark'}}">
  <view class="head stats-head">
    <text class="h-title">数据统计</text>
    <text class="h-sub">训练量、打卡与力量成长，集中在一页看清</text>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <block wx:if="{{!loading}}">
    <view class="metric-grid stats-metrics" wx:if="{{hasData}}">
      <view class="metric-card">
        <text class="metric-value grad-text">{{totalWorkouts}}</text>
        <text class="metric-label">次训练</text>
      </view>
      <view class="metric-card">
        <text class="metric-value">{{totalVolume}}</text>
        <text class="metric-label">总容量 kg</text>
      </view>
      <view class="metric-card">
        <text class="metric-value">{{monthCheckins}}</text>
        <text class="metric-label">本月打卡</text>
      </view>
    </view>

    <view class="empty" wx:if="{{!hasData}}">
      <text class="empty-emoji">📊</text>
      <text class="empty-text">还没有训练数据</text>
      <text class="empty-sub">去首页「开始训练」记录第一练吧</text>
    </view>

    <!-- 训练量趋势 -->
    <view class="card stats-card" wx:if="{{hasData}}">
      <view class="section-head">
        <text class="section-title">近 14 天训练量</text>
        <text class="section-meta">有柱即有训练</text>
      </view>
      <view class="chart">
        <view class="bar-col" wx:for="{{trend}}" wx:key="dateStr">
          <view class="bar {{item.trained ? 'bar-on' : ''}}" style="height:{{item.heightPct}}%"></view>
          <text class="bar-day">{{item.day}}</text>
        </view>
      </view>
    </view>

    <!-- 动作最大重量 Top5 -->
    <view class="card stats-card" wx:if="{{maxByExercise.length > 0}}">
      <view class="section-head">
        <text class="section-title">动作最大重量</text>
        <text class="section-meta">Top 5</text>
      </view>
      <view class="ex-list">
        <view class="ex-row" wx:for="{{maxByExercise}}" wx:key="name">
          <text class="ex-name">{{item.name}}</text>
          <view class="ex-bar-wrap">
            <view class="ex-bar" style="width:{{item.heightPct}}%"></view>
          </view>
          <text class="ex-val">{{item.max}}kg</text>
        </view>
      </view>
    </view>

    <!-- 身体数据入口 -->
    <view class="card link-card stats-card" bindtap="goBody">
      <text class="lc-label">身体数据</text>
      <text class="lc-sub">记录体重 / 体脂 / 围度</text>
      <text class="lc-arrow">›</text>
    </view>
  </block>
</view>
