<view class="page tab-page stats-page theme-{{theme ? theme : 'light'}}">
  <view class="head"><text class="eyebrow">PERFORMANCE</text><text class="h-title">数据统计</text><text class="h-sub">用趋势和训练量，确认自己正在变强</text></view>
  <view class="loading" wx:if="{{loading}}">正在整理数据</view>
  <block wx:if="{{!loading}}">
    <view class="stats-summary" wx:if="{{hasData}}"><view><text>{{totalWorkouts}}</text><text>训练次数</text></view><view><text>{{totalVolume}}</text><text>总容量 kg</text></view><view><text>{{monthCheckins}}</text><text>本月打卡</text></view></view>
    <view class="empty" wx:if="{{!hasData}}"><text class="empty-text">还没有训练数据</text><text class="empty-sub">完成一次训练后，这里会开始记录趋势</text></view>
    <view class="stats-section" wx:if="{{hasData}}"><view class="stats-section-head"><text>近 14 天训练量</text><text>每日组数</text></view><view class="chart"><view class="bar-col" wx:for="{{trend}}" wx:key="dateStr"><view class="bar {{item.trained ? 'bar-on' : ''}}" style="height:{{item.heightPct}}%"></view><text>{{item.day}}</text></view></view></view>
    <view class="stats-section" wx:if="{{hasData}}"><view class="stats-section-head"><text>本月训练日</text><text>{{monthCheckins}} 天</text></view><view class="stats-week"><text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text></view><view class="stats-calendar"><view wx:for="{{calendar}}" wx:key="index" class="stats-cell {{item.trained ? 'on' : ''}} {{item.isToday ? 'today' : ''}}"><text>{{item.day}}</text></view></view></view>
    <view class="stats-section" wx:if="{{maxByExercise.length > 0}}"><view class="stats-section-head"><text>动作最大重量</text><text>Top 5</text></view><view class="max-list"><view class="max-row" wx:for="{{maxByExercise}}" wx:key="name"><text class="max-name">{{item.name}}</text><view class="max-track"><view class="max-bar" style="width:{{item.heightPct}}%"></view></view><text class="max-value">{{item.max}} kg</text></view></view></view>
    <view class="stats-link" bindtap="goBody"><view><text>身体数据</text><text>记录体重、体脂与围度变化</text></view><text>→</text></view>
  </block>
</view>
