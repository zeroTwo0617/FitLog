.stats-head { margin-bottom: 22rpx; }
.stats-metrics { margin-bottom: 28rpx; }
.stats-metrics .metric-card { padding: 22rpx 18rpx; }
.stats-metrics .metric-value { font-size: 36rpx; }
.stats-card { margin-bottom: 20rpx; }

/* 训练量柱状图 */
.chart { display: flex; align-items: flex-end; gap: 8rpx; height: 220rpx; padding-top: 12rpx; border-bottom: 1rpx solid var(--hairline); }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end; }
.bar {
  width: 100%; min-height: 4rpx; border-radius: 8rpx 8rpx 0 0;
  background: rgba(79, 140, 255, 0.25);
  transition: height 0.4s ease;
}
.bar-on {
  background: linear-gradient(180deg, var(--primary), var(--primary-2));
  box-shadow: var(--shadow-glow);
}
.bar-day { margin-top: 8rpx; font-size: 18rpx; color: var(--text-dim); }

/* 日历 */
.cal-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.cal-nav { display: flex; align-items: center; gap: 12rpx; }
.cal-arrow {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; line-height: 1; color: var(--text);
  background: var(--inset); border: 1rpx solid var(--hairline);
  transition: transform 0.15s ease, opacity 0.2s ease;
}
.cal-arrow:active { transform: scale(0.9); }
.cal-arrow.disabled { opacity: 0.3; }
.cal-mlabel { font-size: 28rpx; font-weight: 600; min-width: 200rpx; text-align: center; }
.cal-week { display: flex; margin-bottom: 12rpx; }
.cal-wd { flex: 1; text-align: center; font-size: 22rpx; color: var(--text-dim); }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.28%; height: 76rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: var(--text-dim);
  box-sizing: border-box;
}
.cal-cell.on { color: #fff; font-weight: 700; }
.cal-cell.on text {
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-2));
  box-shadow: 0 4rpx 14rpx rgba(79, 140, 255, 0.4);
}
.cal-cell.today text { border: 2rpx solid var(--primary-2); }

/* 图例 */
.cal-legend { display: flex; gap: 36rpx; margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid var(--hairline); }
.lg-item { display: flex; align-items: center; gap: 10rpx; font-size: 22rpx; color: var(--text-dim); }
.lg-dot { width: 24rpx; height: 24rpx; border-radius: 50%; background: var(--inset); border: 1rpx solid var(--hairline); }
.lg-dot.on { background: linear-gradient(135deg, var(--primary), var(--primary-2)); border-color: transparent; box-shadow: 0 2rpx 8rpx rgba(79, 140, 255, 0.4); }

/* 最大重量 Top5 */
.ex-list { display: flex; flex-direction: column; gap: 18rpx; }
.ex-row { display: flex; align-items: center; gap: 14rpx; }
.ex-name { width: 160rpx; font-size: 26rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ex-bar-wrap { flex: 1; height: 18rpx; background: var(--hairline); border-radius: 999rpx; overflow: hidden; }
.ex-bar { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, var(--primary), var(--primary-2)); }
.ex-val { width: 96rpx; text-align: right; font-size: 24rpx; color: var(--text); }

/* 身体数据入口 */
.link-card { display: flex; align-items: center; gap: 16rpx; }
.lc-label { font-size: 30rpx; font-weight: 600; }
.lc-sub { flex: 1; font-size: 24rpx; color: var(--text-dim); }
.lc-arrow { font-size: 36rpx; color: var(--text-dim); }
