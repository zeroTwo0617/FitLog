.stats-page { padding-top: 24rpx; }
.eyebrow { display: block; margin-bottom: 12rpx; color: var(--primary); font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }
.stats-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-bottom: 22rpx; }
.stats-summary view { padding: 16rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); }
.stats-summary text { display: block; }
.stats-summary text:first-child { color: var(--text); font-size: 31rpx; font-weight: 750; }
.stats-summary text:last-child { margin-top: 7rpx; color: var(--text-dim); font-size: 20rpx; }
.stats-section { margin-bottom: 16rpx; padding: 20rpx 16rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-card); }
.stats-section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18rpx; }
.stats-section-head text:first-child { color: var(--text); font-size: 27rpx; font-weight: 700; }
.stats-section-head text:last-child { color: var(--text-dim); font-size: 20rpx; }
.chart { display: flex; align-items: flex-end; gap: 7rpx; height: 210rpx; padding-top: 8rpx; border-bottom: 1rpx solid var(--hairline); }
.bar-col { display: flex; flex: 1; height: 100%; flex-direction: column; align-items: center; justify-content: flex-end; min-width: 0; }
.bar { width: 100%; min-height: 4rpx; border-radius: 4rpx 4rpx 0 0; background: var(--surface-3); }
.bar-on { background: var(--primary); }
.bar-col text { margin-top: 8rpx; color: var(--text-dim); font-size: 17rpx; }
.stats-week, .stats-calendar { display: flex; flex-wrap: wrap; }
.stats-week text, .stats-cell { width: 14.28%; text-align: center; }
.stats-week text { color: var(--text-dim); font-size: 19rpx; }
.stats-cell { display: flex; align-items: center; justify-content: center; height: 63rpx; color: var(--text-dim); font-size: 21rpx; }
.stats-cell text { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-radius: 50%; }
.stats-cell.on text { background: var(--primary); color: #fff; font-weight: 700; }
.stats-cell.today text { border: 2rpx solid var(--accent); }
.max-list { display: flex; flex-direction: column; gap: 14rpx; }
.max-row { display: flex; align-items: center; gap: 10rpx; }
.max-name { width: 150rpx; overflow: hidden; color: var(--text); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.max-track { flex: 1; height: 12rpx; overflow: hidden; border-radius: 999rpx; background: var(--surface-2); }
.max-bar { height: 100%; border-radius: 999rpx; background: var(--primary); }
.max-value { width: 88rpx; color: var(--text-dim); font-size: 19rpx; text-align: right; }
.stats-link { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 4rpx; padding: 20rpx 16rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius); background: var(--surface); }
.stats-link text { display: block; }
.stats-link text:first-child { color: var(--text); font-size: 27rpx; font-weight: 700; }
.stats-link text:last-child { color: var(--text-dim); font-size: 20rpx; }
.stats-link view text:last-child { margin-top: 6rpx; color: var(--text-dim); font-size: 20rpx; font-weight: 400; }
