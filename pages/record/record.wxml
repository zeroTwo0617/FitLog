<view class="page record theme-{{theme ? theme : 'dark'}}">
  <view class="record-header"><view><text class="eyebrow">NEW SESSION</text><text class="h-title">{{title ? title : '记录训练'}}</text><text class="h-sub">{{today}} · 每一组都算数</text></view><view class="record-mode">{{planId ? '计划' : '自由'}}</view></view>
  <view class="record-summary"><view><text>{{exerciseCount}}</text><text>动作</text></view><view><text>{{totalSets}}</text><text>总组数</text></view><view><text>{{planId ? '已选' : '待选'}}</text><text>训练计划</text></view></view>

  <view class="plan-bar" wx:if="{{!planId}}"><button class="btn-import" bindtap="openPlanPicker"><text>＋</text> 从计划开始</button></view>
  <view class="plan-bar plan-active" wx:if="{{planId}}"><view><text class="plan-on-label">当前计划</text><text class="plan-on-name">{{title}}</text></view><text class="plan-on-clear" bindtap="clearPlan">取消关联</text></view>

  <view class="session" wx:if="{{session.length > 0}}">
    <view class="exercise-card" wx:for="{{session}}" wx:key="exerciseId">
      <view class="exercise-header"><view><text class="exercise-index">0{{index + 1}}</text><text class="exercise-name">{{item.name}}</text></view><text class="exercise-remove" bindtap="removeExercise" data-idx="{{index}}">移除</text></view>
      <view class="exercise-target" wx:if="{{item.targetSets || item.targetReps || item.targetWeight}}"><text wx:if="{{item.targetSets}}">目标 {{item.targetSets}} 组</text><text wx:if="{{item.targetReps}}"> · {{item.targetReps}} 次</text><text wx:if="{{item.targetWeight}}"> · {{item.targetWeight}} kg</text></view>
      <view class="set-row set-head"><text>组</text><text>次数</text><text>重量</text><text>休息</text><text>完成</text><text></text></view>
      <view class="set-row {{s.completed ? 'set-done' : ''}}" wx:for="{{item.sets}}" wx:for-item="s" wx:for-index="si" wx:key="si"><text class="set-no">{{si + 1}}</text><input class="set-input" type="number" placeholder="-" value="{{s.reps}}" bindinput="onReps" data-idx="{{index}}" data-sidx="{{si}}" /><input class="set-input" type="digit" placeholder="-" value="{{s.weight}}" bindinput="onWeight" data-idx="{{index}}" data-sidx="{{si}}" /><input class="set-input" type="number" placeholder="-" value="{{s.rest}}" bindinput="onRest" data-idx="{{index}}" data-sidx="{{si}}" /><view class="set-check {{s.completed ? 'ok' : ''}}" catchtap="toggleSet" data-idx="{{index}}" data-sidx="{{si}}">✓</view><text class="set-remove" bindtap="removeSet" data-idx="{{index}}" data-sidx="{{si}}">×</text></view>
      <button class="add-set" bindtap="addSet" data-idx="{{index}}">＋ 添加一组</button>
    </view>
  </view>
  <view class="empty record-empty" wx:if="{{session.length === 0}}"><text class="empty-text">还没有动作</text><text class="empty-sub">先添加动作，再开始填写训练数据</text></view>
  <button class="btn-add add-exercise" bindtap="togglePicker">{{showPicker ? '收起动作库' : '＋ 添加动作'}}</button>

  <view class="picker-mask" wx:if="{{showPicker}}" bindtap="togglePicker"><view class="sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-title-row"><text class="sheet-title">添加动作</text><text class="sheet-count">{{pickerList.length}} 个结果</text></view><input class="search-input" placeholder="搜索中文或英文动作" value="{{keyword}}" bindinput="onSearch" confirm-type="search" /><scroll-view class="cats" scroll-x="true" enhanced="true" show-scrollbar="false"><view wx:for="{{categories}}" wx:key="key" class="chip {{activeCat === item.key ? 'chip-on' : ''}}" data-cat="{{item.key}}" bindtap="onCat">{{item.label}}</view></scroll-view><scroll-view class="pick-list" scroll-y="true"><view wx:for="{{pickerList}}" wx:key="id" class="pick-item" bindtap="addExercise" data-id="{{item.id}}"><view><text class="pick-name">{{item.nameZh}}</text><text class="pick-meta">{{item.bpZh}} · {{item.eqZh}}</text></view><text class="pick-add">＋</text></view></scroll-view></view></view>
  <view class="plan-picker-mask" wx:if="{{showPlanPicker}}" bindtap="closePlanPicker"><view class="plan-sheet" catchtap="noop"><view class="sheet-handle"></view><text class="sheet-title">选择训练计划</text><scroll-view class="plan-pick-list" scroll-y="true"><view wx:for="{{planList}}" wx:key="_id" class="plan-pick-item" bindtap="pickPlan" data-id="{{item._id}}"><view><text class="pp-name">{{item.name}}</text><text class="pp-meta">{{item.count}} 个动作</text></view><text class="pick-add">→</text></view><view wx:if="{{planList.length === 0}}" class="plan-empty">还没有计划，去「我的」页创建</view></scroll-view><button class="pp-cancel" bindtap="closePlanPicker">取消</button></view></view>
  <button class="btn-save save-button" bindtap="save" disabled="{{saving}}">{{saving ? '保存中…' : '保存训练'}}</button>
</view>
