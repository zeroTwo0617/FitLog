.history-page { padding-top: 24rpx; }
.history-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; margin-bottom: 22rpx; }
.eyebrow { display: block; margin-bottom: 12rpx; color: var(--primary); font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }
.latest-date { flex: none; padding-top: 28rpx; color: var(--text-dim); font-size: 20rpx; }
.history-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-bottom: 24rpx; }
.history-summary view { padding: 16rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); }
.history-summary text { display: block; }
.history-summary text:first-child { color: var(--text); font-size: 31rpx; font-weight: 750; }
.history-summary text:last-child { margin-top: 7rpx; color: var(--text-dim); font-size: 20rpx; }
.history-list { border-top: 1rpx solid var(--card-border); }
.history-row { display: grid; grid-template-columns: 190rpx minmax(0, 1fr) 32rpx; align-items: center; gap: 12rpx; min-height: 118rpx; border-bottom: 1rpx solid var(--card-border); }
.history-row:active { opacity: 0.68; }
.history-date text { display: block; }
.history-date text:first-child { color: var(--text); font-size: 23rpx; font-weight: 700; }
.history-date text:last-child { margin-top: 7rpx; overflow: hidden; color: var(--text-dim); font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.history-main { min-width: 0; }
.history-names { display: block; overflow: hidden; color: var(--text); font-size: 25rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.history-meta { display: block; margin-top: 7rpx; color: var(--text-dim); font-size: 20rpx; }
.history-arrow { color: var(--text-dim); font-size: 28rpx; text-align: right; }
