<view class="page tab-page exercises-page theme-{{theme ? theme : 'light'}}">
  <view class="exercises-header"><view><text class="eyebrow">EXERCISE LIBRARY</text><text class="h-title">动作库</text><text class="h-sub">按部位找到下一组要练的动作</text></view><view class="result-total"><text>{{list.length}}</text><text>当前结果</text></view></view>
  <view class="search-box"><input class="search-input" placeholder="搜索动作名称或英文名" value="{{keyword}}" bindinput="onSearch" confirm-type="search" /><view class="search-meta"><text class="tag">{{activeCatLabel}}</text><text>{{totalCount}} 个动作</text></view></view>
  <view class="library-body"><scroll-view class="category-list" scroll-y="true" enhanced="true" show-scrollbar="false"><view wx:for="{{categories}}" wx:key="key" class="category-item {{activeCat===item.key ? 'active' : ''}}" data-cat="{{item.key}}" bindtap="onCat"><text>{{item.label}}</text><text>{{item.count}}</text></view></scroll-view><scroll-view class="exercise-list" scroll-y="true" enhanced="true" show-scrollbar="false" scroll-top="{{scrollTop}}"><view class="exercise-row" wx:for="{{list}}" wx:key="id" bindtap="onOpen" data-id="{{item.id}}"><view class="exercise-mark">{{item.initial}}</view><view class="exercise-copy"><view class="exercise-name-line"><text>{{item.nameZh}}</text><text class="exercise-arrow">→</text></view><text class="exercise-en">{{item.name}}</text><view class="exercise-meta"><text class="tag">{{item.tgZh}}</text><text>{{item.eqZh}}</text><text>{{item.bpZh}}</text></view></view></view><view wx:if="{{list.length===0}}" class="empty"><text class="empty-text">没有匹配的动作</text><text class="empty-sub">换个关键词或切换分类试试</text></view><view wx:else class="list-end">已显示 {{list.length}} 个动作</view></scroll-view></view>
</view>
