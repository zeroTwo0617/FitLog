.exercises-page { display: flex; height: 100vh; flex-direction: column; overflow: hidden; padding-top: 24rpx; padding-bottom: 0; }
.exercises-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.eyebrow { display: block; margin-bottom: 12rpx; color: var(--primary); font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }
.result-total { display: flex; flex: none; flex-direction: column; align-items: flex-end; padding-top: 24rpx; color: var(--text-dim); font-size: 20rpx; }
.result-total text:first-child { color: var(--primary); font-size: 35rpx; font-weight: 750; line-height: 1; }
.result-total text:last-child { margin-top: 6rpx; }
.search-box { flex: none; padding-bottom: 18rpx; border-bottom: 1rpx solid var(--card-border); }
.search-meta { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin-top: 12rpx; color: var(--text-dim); font-size: 20rpx; }
.search-meta .tag { color: var(--primary); }
.library-body { display: flex; flex: 1; min-height: 0; padding-top: 16rpx; }
.category-list { width: 164rpx; flex: none; height: 100%; padding-right: 14rpx; }
.category-item { display: flex; align-items: center; justify-content: space-between; min-height: 62rpx; margin-bottom: 5rpx; padding: 0 12rpx; border-left: 4rpx solid transparent; color: var(--text-dim); font-size: 23rpx; }
.category-item text:last-child { color: var(--placeholder); font-size: 18rpx; }
.category-item.active { border-left-color: var(--primary); background: var(--primary-soft); color: var(--primary-strong); font-weight: 700; }
.category-item.active text:last-child { color: var(--primary); }
.exercise-list { flex: 1; min-width: 0; height: 100%; padding-left: 14rpx; border-left: 1rpx solid var(--card-border); }
.exercise-row { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--card-border); }
.exercise-row:active { opacity: 0.65; }
.exercise-mark { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; flex: none; border-radius: var(--radius-sm); background: var(--primary-soft); color: var(--primary); font-size: 25rpx; font-weight: 750; }
.exercise-copy { flex: 1; min-width: 0; }
.exercise-name-line { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.exercise-name-line text:first-child { overflow: hidden; color: var(--text); font-size: 25rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.exercise-arrow { color: var(--text-dim); font-size: 24rpx; }
.exercise-en { display: block; margin-top: 5rpx; overflow: hidden; color: var(--text-dim); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.exercise-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; margin-top: 8rpx; color: var(--text-dim); font-size: 18rpx; }
.exercise-meta .tag { margin: 0; }
.list-end { padding: 20rpx 0 40rpx; color: var(--text-dim); font-size: 19rpx; text-align: center; }
