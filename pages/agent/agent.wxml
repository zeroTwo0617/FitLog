<view class="page agent-page theme-{{theme}}">
  <scroll-view class="messages" scroll-y="true" scroll-into-view="msg-{{messages.length - 1}}">
    <view wx:for="{{messages}}" wx:key="index" id="msg-{{index}}" class="message {{item.role}}">
      <view class="bubble">{{item.content}}</view>
    </view>
    <view wx:if="{{sending}}" class="typing">正在设计计划...</view>
    <view wx:if="{{planDraft}}" class="draft card">
      <view class="draft-head"><text class="draft-title">计划草案</text><text class="draft-count">{{planDraft.items.length}} 个动作</text></view>
      <view wx:for="{{planDraft.items}}" wx:key="exerciseId" class="draft-item">
        <text>{{item.exerciseName}}</text>
        <text class="draft-meta">{{item.targetSets}} 组 × {{item.targetReps}} 次</text>
      </view>
      <button class="btn-primary" bindtap="saveDraft">确认并编辑计划</button>
    </view>
  </scroll-view>
  <view class="composer">
    <input class="agent-input" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="send" placeholder="描述你的目标或训练问题" maxlength="500" />
    <button wx:if="{{sending}}" class="btn-stop" bindtap="stop">停止</button>
    <button wx:else class="btn-send" bindtap="send" disabled="{{!input}}">发送</button>
  </view>
</view>
