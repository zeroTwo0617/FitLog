.agent-page {
  height: 100vh;
  padding: 28rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.mode-tabs {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  background: var(--surface-2);
}

.mode-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  color: var(--text-dim);
  font-size: 24rpx;
  border-radius: 8rpx;
}

.mode-on {
  color: var(--primary);
  background: var(--surface);
  box-shadow: 0 4rpx 12rpx rgba(25, 35, 55, 0.06);
  font-weight: 700;
}

.agent-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.text-btn {
  flex: none;
  padding: 8rpx 0;
  color: var(--text-dim);
  font-size: 24rpx;
}

.context-note {
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: var(--surface-2);
  color: var(--text-dim);
  font-size: 22rpx;
}

.error-note {
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: 10rpx;
  background: #fff7ed;
  color: #b45309;
  font-size: 22rpx;
}

.meal-tools {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.date-picker, .meal-picker {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  background: var(--surface);
  color: var(--text);
  font-size: 22rpx;
}

.small-primary, .small-outline {
  width: auto;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.small-primary { color: #fff; background: var(--primary); }
.small-outline { color: var(--text-dim); border: 1rpx solid var(--border); }

.messages {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 12rpx 0 24rpx;
  box-sizing: border-box;
}

.message {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.message.user { align-items: flex-end; }

.message-label {
  margin: 0 0 8rpx 8rpx;
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.bubble {
  max-width: 86%;
  padding: 20rpx 22rpx;
  border-radius: 6rpx 18rpx 18rpx 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  color: var(--text);
  line-height: 1.65;
  white-space: pre-wrap;
  box-shadow: 0 4rpx 14rpx rgba(25, 35, 55, 0.04);
}

.message.user .bubble {
  border-radius: 18rpx 6rpx 18rpx 18rpx;
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.typing {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--text-dim);
  font-size: 24rpx;
  padding: 6rpx 0 24rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  animation: pulse 0.9s ease-in-out infinite alternate;
}

@keyframes pulse { from { opacity: 0.35; } to { opacity: 1; } }

.draft {
  margin: 4rpx 0 28rpx;
  padding: 24rpx;
  background: var(--surface);
  box-shadow: 0 8rpx 24rpx rgba(25, 35, 55, 0.06);
}

.draft-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.draft-kicker, .draft-title { display: block; }
.draft-kicker { color: var(--primary); font-size: 20rpx; font-weight: 700; }
.draft-title { margin-top: 6rpx; font-size: 32rpx; font-weight: 700; }
.draft-count, .draft-meta { color: var(--text-dim); font-size: 22rpx; }
.draft-item { display: flex; justify-content: space-between; gap: 12rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--hairline); }
.draft-name { flex: 1; min-width: 0; }
.draft .btn-primary { margin-top: 22rpx; }

.target-line, .meal-foods, .privacy-note {
  display: block;
  color: var(--text-dim);
  font-size: 22rpx;
  line-height: 1.5;
}

.meal-foods { margin-top: 6rpx; }

.diet-targets {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin: 16rpx 0 4rpx;
}

.diet-targets > view {
  padding: 8rpx;
  border-radius: 8rpx;
  background: var(--surface-2);
}

.diet-targets text { display: block; color: var(--text-dim); font-size: 18rpx; }
.diet-targets input { width: 100%; height: 46rpx; line-height: 46rpx; color: var(--text); font-size: 23rpx; }
.diet-meal-calories { width: 124rpx; height: 56rpx; line-height: 56rpx; padding: 0 10rpx; border-radius: 8rpx; background: var(--surface-2); color: var(--text); font-size: 22rpx; }

.meal-fields {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin: 16rpx 0;
}

.meal-field {
  min-width: 0;
  padding: 10rpx;
  border-radius: 8rpx;
  background: var(--surface-2);
}

.meal-field text {
  display: block;
  color: var(--text-dim);
  font-size: 18rpx;
}

.meal-field input {
  width: 100%;
  height: 48rpx;
  line-height: 48rpx;
  color: var(--text);
  font-size: 24rpx;
}

.food-row {
  display: flex;
  gap: 8rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}

.food-row input {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: var(--surface-2);
  color: var(--text);
  font-size: 22rpx;
}

.food-name { flex: 1.3; min-width: 0; }
.food-portion { flex: 1; min-width: 0; }
.food-calories { width: 112rpx; }
.privacy-note { margin-top: 16rpx; }

.assistant-actions { padding: 0 0 16rpx; }
.outline-btn { width: 100%; padding: 16rpx 0; border: 1rpx solid var(--border); border-radius: 10rpx; color: var(--text-dim); font-size: 24rpx; }

.composer {
  display: flex;
  gap: 12rpx;
  padding: 14rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 22rpx rgba(25, 35, 55, 0.08);
}

.agent-input { flex: 1; min-width: 0; height: 76rpx; line-height: 76rpx; padding: 0 18rpx; border-radius: 10rpx; background: var(--surface-2); color: var(--text); }
.btn-send, .btn-stop { width: 126rpx; height: 76rpx; line-height: 76rpx; border-radius: 10rpx; color: #fff; background: var(--primary); font-size: 26rpx; }
.btn-stop { background: var(--danger); }
