.agent-page { display: flex; flex-direction: column; min-height: 100vh; padding-bottom: 42rpx; }
.messages { flex: 1; min-height: 520rpx; max-height: 62vh; margin-bottom: 22rpx; }
.message { display: flex; margin: 14rpx 0; }
.message.user { justify-content: flex-end; }
.bubble { max-width: 82%; padding: 20rpx 24rpx; border-radius: 20rpx; background: var(--surface-2); color: var(--text); line-height: 1.55; white-space: pre-wrap; }
.message.user .bubble { background: var(--primary); color: #fff; border-bottom-right-radius: 6rpx; }
.message.assistant .bubble { border-bottom-left-radius: 6rpx; }
.empty { padding: 76rpx 28rpx; margin-top: 80rpx; }
.draft { margin-bottom: 20rpx; }
.draft-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18rpx; }
.draft-title { font-weight: 700; font-size: 30rpx; }
.draft-count { color: var(--text-dim); font-size: 23rpx; }
.draft-item { display: flex; justify-content: space-between; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--border); }
.draft-item:last-of-type { border-bottom: 0; }
.draft-name { flex: 1; min-width: 0; }
.draft-target { color: var(--text-dim); font-size: 23rpx; }
.error { margin: 12rpx 0; padding: 16rpx 20rpx; color: var(--danger); background: rgba(248,113,113,.12); border-radius: var(--radius-sm); font-size: 24rpx; }
.composer { display: flex; align-items: flex-end; gap: 14rpx; padding: 16rpx; background: var(--surface); border: 1rpx solid var(--border); border-radius: var(--radius); }
.composer-input { flex: 1; min-height: 72rpx; max-height: 180rpx; color: var(--text); line-height: 1.45; }
.send, .stop { width: 150rpx; padding: 18rpx 0; flex-shrink: 0; }
.retry { margin-top: 16rpx; }
