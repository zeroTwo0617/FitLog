.agent-page {
  height: 100vh;
  padding: 24rpx 24rpx calc(152rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.mode-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 4rpx;
  padding: 4rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  background: var(--surface-2);
}

.mode-tab {
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  color: var(--text-dim);
  font-size: 24rpx;
  border-radius: 7rpx;
}

.mode-on {
  color: var(--primary);
  background: var(--surface);
  box-shadow: 0 4rpx 12rpx rgba(25, 35, 55, 0.06);
  font-weight: 700;
}

.agent-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.text-btn {
  flex: none;
  min-width: 124rpx;
  height: 54rpx;
  padding: 0 14rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  background: var(--surface);
  color: var(--text-dim);
  font-size: 24rpx;
  line-height: 54rpx;
}

.context-note {
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: var(--surface-2);
  color: var(--text-dim);
  font-size: 22rpx;
}

.error-note {
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
  border-radius: 10rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 22rpx;
}

.meal-tools {
  flex: none;
  margin-bottom: 10rpx;
  padding: 12rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  background: var(--surface);
}

.meal-context {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
}

.meal-context picker { min-width: 0; }

.tool-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  height: 64rpx;
  padding: 0 12rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  background: var(--surface-2);
  color: var(--text);
}

.tool-label { flex: none; color: var(--text-dim); font-size: 19rpx; }
.tool-value { flex: 1; min-width: 0; overflow: hidden; color: var(--text); font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.tool-chevron { flex: none; color: var(--text-dim); font-size: 28rpx; line-height: 1; }

.meal-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 8rpx;
}

.meal-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  height: 68rpx;
  padding: 0 10rpx;
  border: 1rpx solid var(--border);
  border-radius: 8rpx;
  background: var(--surface-2);
  color: var(--text);
  font-size: 22rpx;
  font-weight: 650;
}

.meal-action-primary { grid-column: 1 / -1; color: var(--on-primary); background: var(--primary); border-color: var(--primary); font-weight: 800; }
.meal-action image { width: 30rpx; height: 30rpx; flex: none; }
.meal-action-primary image { filter: brightness(0); }
.meal-action-symbol { color: var(--primary); font-size: 30rpx; line-height: 1; }
.meal-action:active { opacity: .78; }

.messages {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 12rpx 0 24rpx;
  box-sizing: border-box;
}

.message {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.message.user { align-items: flex-end; }

.message-label {
  margin: 0 0 8rpx 8rpx;
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.bubble {
  max-width: 86%;
  padding: 20rpx 22rpx;
  border-radius: 6rpx 18rpx 18rpx 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  color: var(--text);
  line-height: 1.65;
  white-space: pre-wrap;
  box-shadow: 0 4rpx 14rpx rgba(25, 35, 55, 0.04);
}

.message.user .bubble {
  border-radius: 18rpx 6rpx 18rpx 18rpx;
  background: linear-gradient(135deg, #d9ff6b, #9fd42f);
  border-color: transparent;
  color: #12160a;
  font-weight: 600;
}

.typing {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--text-dim);
  font-size: 24rpx;
  padding: 6rpx 0 24rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  animation: pulse 0.9s ease-in-out infinite alternate;
}

@keyframes pulse { from { opacity: 0.35; } to { opacity: 1; } }

.draft {
  margin: 4rpx 0 28rpx;
  padding: 24rpx;
  background: var(--surface);
  box-shadow: 0 8rpx 24rpx rgba(25, 35, 55, 0.06);
}

.draft-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.draft-kicker, .draft-title { display: block; }
.draft-kicker { color: var(--primary); font-size: 20rpx; font-weight: 700; }
.draft-title { margin-top: 6rpx; font-size: 32rpx; font-weight: 700; }
.draft-count, .draft-meta { color: var(--text-dim); font-size: 22rpx; }
.draft-item { display: flex; justify-content: space-between; gap: 12rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--hairline); }
.draft-name { flex: 1; min-width: 0; }
.draft .btn-primary { margin-top: 22rpx; }

.target-line, .meal-foods, .privacy-note {
  display: block;
  color: var(--text-dim);
  font-size: 22rpx;
  line-height: 1.5;
}

.meal-foods { margin-top: 6rpx; }

.diet-targets {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin: 16rpx 0 4rpx;
}

.diet-targets > view {
  padding: 8rpx;
  border-radius: 8rpx;
  background: var(--surface-2);
}

.diet-targets text { display: block; color: var(--text-dim); font-size: 18rpx; }
.diet-targets input { width: 100%; height: 46rpx; line-height: 46rpx; color: var(--text); font-size: 23rpx; }
.diet-meal-calories { width: 124rpx; height: 56rpx; line-height: 56rpx; padding: 0 10rpx; border-radius: 8rpx; background: var(--surface-2); color: var(--text); font-size: 22rpx; }

.meal-fields {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin: 16rpx 0;
}

.meal-field {
  min-width: 0;
  padding: 10rpx;
  border-radius: 8rpx;
  background: var(--surface-2);
}

.meal-field text {
  display: block;
  color: var(--text-dim);
  font-size: 18rpx;
}

.meal-field input {
  width: 100%;
  height: 48rpx;
  line-height: 48rpx;
  color: var(--text);
  font-size: 24rpx;
}

.food-row {
  display: flex;
  gap: 8rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}

.food-row input {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: var(--surface-2);
  color: var(--text);
  font-size: 22rpx;
}

.food-name { flex: 1.3; min-width: 0; }
.food-portion { flex: 1; min-width: 0; }
.food-calories { width: 112rpx; }
.privacy-note { margin-top: 16rpx; }
.macro-note { display: block; margin-top: 12rpx; color: var(--primary); font-size: 20rpx; }

.assistant-actions { padding: 0 0 16rpx; }
.outline-btn { width: 100%; height: 60rpx; padding: 0; border: 1rpx solid var(--border); border-radius: 8rpx; color: var(--text-dim); font-size: 22rpx; line-height: 60rpx; }

.composer {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  padding: 10rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  box-shadow: 0 8rpx 22rpx rgba(25, 35, 55, 0.08);
}

.agent-input { flex: 1 1 auto; min-width: 0; height: 84rpx; box-sizing: border-box; line-height: 84rpx; padding: 0 18rpx; border: 1rpx solid var(--border); border-radius: 10rpx; background: var(--surface-2); color: var(--text); }
.btn-send, .btn-stop { display: flex; align-items: center; justify-content: center; width: 96rpx !important; min-width: 96rpx; max-width: 96rpx; height: 64rpx; box-sizing: border-box; flex: 0 0 96rpx; padding: 0; line-height: 1; border-radius: 9rpx; color: var(--on-primary); background: var(--primary); font-size: 23rpx; font-weight: 800; }
.btn-send[disabled] { opacity: 1; color: var(--text-dim); background: var(--surface-3); }
.btn-stop { background: var(--danger); }
