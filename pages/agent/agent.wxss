.agent-page { min-height: 100vh; padding: 0 0 150rpx; box-sizing: border-box; display: flex; flex-direction: column; }
.messages { flex: 1; min-height: 0; height: 0; padding: 28rpx; box-sizing: border-box; }
.message { display: flex; margin-bottom: 20rpx; }
.message.user { justify-content: flex-end; }
.bubble { max-width: 78%; padding: 20rpx 24rpx; border-radius: 20rpx; background: var(--surface-2); color: var(--text); line-height: 1.55; white-space: pre-wrap; }
.message.user .bubble { background: var(--primary); color: #fff; }
.typing { color: var(--text-dim); font-size: 24rpx; padding: 10rpx 0 24rpx; }
.draft { margin: 12rpx 0 30rpx; padding: 24rpx; }
.draft-head { display: flex; justify-content: space-between; margin-bottom: 18rpx; }
.draft-title { font-weight: 700; font-size: 30rpx; }
.draft-count, .draft-meta { color: var(--text-dim); font-size: 23rpx; }
.draft-item { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--hairline); }
.draft .btn-primary { margin-top: 24rpx; }
.composer { display: flex; gap: 14rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--hairline); }
.agent-input { flex: 1; height: 82rpx; line-height: 82rpx; padding: 0 20rpx; border-radius: 16rpx; background: var(--surface-2); color: var(--text); }
.btn-send, .btn-stop { width: 132rpx; height: 82rpx; line-height: 82rpx; border-radius: 16rpx; color: #fff; background: var(--primary); font-size: 27rpx; }
.btn-stop { background: var(--danger); }
