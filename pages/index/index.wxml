<view class="page tab-page home theme-{{theme ? theme : 'light'}}">
  <view class="hero-card">
    <view class="hero-top">
      <view>
        <text class="badge">FITLOG</text>
        <text class="title">今天也把训练留痕</text>
      </view>
      <text class="date-chip">{{todayText}}</text>
    </view>
    <text class="sub">{{heroNote}}</text>
    <view class="hero-actions">
      <button class="btn-primary hero-main-btn" bindtap="goRecord">开始训练</button>
      <view class="hero-side-actions">
        <view class="pill-btn" bindtap="goPlans">训练计划</view>
        <view class="pill-btn" bindtap="goHistory">训练历史</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">概览</text>
      <text class="section-meta">训练数据一眼看清</text>
    </view>
    <view class="metric-grid">
      <view class="metric-card" wx:for="{{stats}}" wx:key="label">
        <text class="metric-value grad-text">{{item.value}}</text>
        <text class="metric-label">{{item.label}}</text>
        <text class="metric-note">{{item.note}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">快捷入口</text>
      <text class="section-meta">常用功能放前面</text>
    </view>
    <view class="quick-grid">
      <view class="quick-card accent-blue" bindtap="goRecord">
        <text class="quick-kicker">记录</text>
        <text class="quick-title">新建一次训练</text>
        <text class="quick-desc">直接开始，边练边记</text>
      </view>
      <view class="quick-card accent-purple" bindtap="goPlans">
        <text class="quick-kicker">计划</text>
        <text class="quick-title">管理训练模板</text>
        <text class="quick-desc">把常练动作整理成计划</text>
      </view>
      <view class="quick-card" bindtap="goHistory">
        <text class="quick-kicker">历史</text>
        <text class="quick-title">回看训练记录</text>
        <text class="quick-desc">按日期查看完成情况</text>
      </view>
      <view class="quick-card" bindtap="goStats">
        <text class="quick-kicker">统计</text>
        <text class="quick-title">查看趋势变化</text>
        <text class="quick-desc">把进步拉成可见的曲线</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">最近计划</text>
      <text class="section-meta">{{recentPlans.length > 0 ? '点开继续跟练' : '还没有计划'}}</text>
    </view>
    <view wx:if="{{recentPlans.length > 0}}" class="plan-list">
      <view class="plan-card" wx:for="{{recentPlans}}" wx:key="_id" bindtap="openPlan" data-id="{{item._id}}">
        <view class="plan-copy">
          <text class="plan-name">{{item.name}}</text>
          <text class="plan-preview">{{item.preview}}</text>
        </view>
        <view class="plan-side">
          <text class="plan-count">{{item.count}}</text>
          <text class="plan-count-label">个动作</text>
        </view>
      </view>
    </view>
    <view wx:else class="card empty-home">
      <text class="empty-text">还没有训练计划</text>
      <text class="empty-sub">先建一个模板，记录时就能一键带入动作和目标。</text>
      <button class="btn-secondary empty-btn" bindtap="goPlans">去创建计划</button>
    </view>
  </view>
</view>
