.home {
  gap: 0;
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(120% 120% at 0% 0%, rgba(79, 140, 255, 0.24), transparent 48%),
    radial-gradient(120% 120% at 100% 100%, rgba(139, 92, 255, 0.18), transparent 52%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.03));
  border: 1rpx solid var(--card-border);
  box-shadow: var(--shadow-card);
}

.theme-light .hero-card {
  background:
    radial-gradient(120% 120% at 0% 0%, rgba(79, 140, 255, 0.18), transparent 48%),
    radial-gradient(120% 120% at 100% 100%, rgba(139, 92, 255, 0.12), transparent 52%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.84));
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.badge {
  display: block;
  letter-spacing: 6rpx;
  color: var(--primary);
  font-weight: 700;
  font-size: 22rpx;
}

.title {
  display: block;
  margin-top: 14rpx;
  font-size: 58rpx;
  line-height: 1.1;
  font-weight: 800;
  color: var(--text);
}

.date-chip {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  color: var(--text-dim);
  font-size: 22rpx;
}

.theme-light .date-chip {
  background: rgba(15, 17, 21, 0.04);
  border-color: rgba(15, 17, 21, 0.06);
}

.sub {
  display: block;
  margin-top: 18rpx;
  color: var(--text-dim);
  font-size: 28rpx;
  line-height: 1.55;
  max-width: 580rpx;
}

.hero-actions {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.95fr);
  gap: 18rpx;
}

.hero-main-btn {
  height: 100%;
  min-height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-side-actions {
  display: grid;
  gap: 18rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.quick-card,
.plan-card {
  border-radius: var(--radius);
  border: 1rpx solid var(--card-border);
  background: var(--card-bg);
}

.quick-card {
  min-height: 196rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.accent-blue {
  background: linear-gradient(180deg, rgba(79, 140, 255, 0.16), rgba(79, 140, 255, 0.05));
}

.accent-purple {
  background: linear-gradient(180deg, rgba(139, 92, 255, 0.16), rgba(139, 92, 255, 0.05));
}

.quick-kicker {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 700;
}

.quick-title {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  line-height: 1.25;
}

.quick-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-dim);
  line-height: 1.45;
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.plan-card {
  padding: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.plan-copy {
  flex: 1;
  min-width: 0;
}

.plan-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.plan-preview {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-dim);
  line-height: 1.45;
}

.plan-side {
  flex-shrink: 0;
  min-width: 96rpx;
  text-align: right;
}

.plan-count {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text);
}

.plan-count-label {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-dim);
}

.empty-home {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.empty-btn {
  margin-top: 8rpx;
}
