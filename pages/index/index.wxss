.home { padding-top: 24rpx; }
.home-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 28rpx; }
.eyebrow { display: block; color: var(--primary); font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }
.home-title { display: block; margin-top: 12rpx; color: var(--text); font-size: 48rpx; font-weight: 760; line-height: 1.1; }
.home-date { display: block; margin-top: 10rpx; color: var(--text-dim); font-size: 23rpx; }
.avatar-mark { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border: 1rpx solid var(--card-border); border-radius: 50%; background: var(--surface); color: var(--primary); font-size: 22rpx; font-weight: 800; }

.start-panel { display: flex; flex-direction: column; justify-content: space-between; min-height: 300rpx; padding: 28rpx; border-radius: var(--radius-lg); background: var(--primary-strong); color: #fff; }
.start-copy { max-width: 560rpx; }
.start-kicker { display: block; color: rgba(255, 255, 255, 0.72); font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.start-title { display: block; margin-top: 16rpx; font-size: 42rpx; font-weight: 760; line-height: 1.2; }
.start-note { display: block; margin-top: 12rpx; color: rgba(255, 255, 255, 0.74); font-size: 23rpx; line-height: 1.5; }
.start-button { align-self: flex-start; min-width: 230rpx; margin-top: 28rpx; padding: 17rpx 22rpx; border-radius: var(--radius-sm); background: #fff; color: var(--primary-strong); font-size: 26rpx; font-weight: 700; }
.start-button text { margin-left: 12rpx; font-size: 30rpx; }

.overview-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.overview-item { min-height: 148rpx; padding: 20rpx 16rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); }
.overview-value { display: block; color: var(--text); font-size: 38rpx; font-weight: 760; line-height: 1; }
.value-accent { color: var(--primary); }
.overview-label { display: block; margin-top: 12rpx; color: var(--text); font-size: 22rpx; font-weight: 600; }
.overview-note { display: block; margin-top: 7rpx; color: var(--text-dim); font-size: 18rpx; line-height: 1.3; }

.nutrition-snapshot { display: flex; align-items: center; gap: 14rpx; margin-top: 20rpx; padding: 18rpx 16rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); }
.nutrition-snapshot:active { opacity: .72; }
.nutrition-snapshot-mark { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; flex: none; border-radius: var(--radius-sm); background: var(--accent-soft); color: var(--accent); font-size: 22rpx; font-weight: 750; }
.nutrition-snapshot-copy { flex: 1; min-width: 0; }
.nutrition-snapshot-title, .nutrition-snapshot-main, .nutrition-snapshot-meta { display: block; }
.nutrition-snapshot-title { color: var(--text-dim); font-size: 19rpx; }
.nutrition-snapshot-main { margin-top: 3rpx; color: var(--text); font-size: 25rpx; font-weight: 700; }
.nutrition-snapshot-meta { overflow: hidden; margin-top: 4rpx; color: var(--text-dim); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.nutrition-snapshot-arrow { flex: none; color: var(--text-dim); font-size: 28rpx; }

.shortcut-list, .plan-list { border-top: 1rpx solid var(--card-border); }
.shortcut-row, .plan-row { display: flex; align-items: center; gap: 16rpx; padding: 19rpx 0; border-bottom: 1rpx solid var(--card-border); }
.shortcut-row:active, .plan-row:active { opacity: 0.7; }
.shortcut-icon { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; flex: none; border-radius: var(--radius-sm); font-size: 24rpx; font-weight: 800; }
.shortcut-icon.teal { background: var(--primary-soft); color: var(--primary); }
.shortcut-icon.orange { background: var(--accent-soft); color: var(--accent); }
.shortcut-icon.blue { background: #e6eef8; color: #3974a9; }
.shortcut-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 6rpx; }
.shortcut-copy text:first-child { color: var(--text); font-size: 27rpx; font-weight: 650; }
.shortcut-copy text:last-child { overflow: hidden; color: var(--text-dim); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.shortcut-arrow { color: var(--text-dim); font-size: 30rpx; }
.plan-row { justify-content: space-between; }
.plan-name { display: block; color: var(--text); font-size: 27rpx; font-weight: 650; }
.plan-preview { display: block; margin-top: 6rpx; color: var(--text-dim); font-size: 21rpx; }
.plan-count { flex: none; color: var(--primary); font-size: 28rpx; font-weight: 750; }
.plan-count text { color: var(--text-dim); font-size: 20rpx; font-weight: 400; }
