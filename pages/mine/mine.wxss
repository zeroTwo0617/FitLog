.mine-page { padding-top: 24rpx; }
.mine-header { display: flex; align-items: center; gap: 18rpx; margin-bottom: 22rpx; }
.avatar-large { display: flex; align-items: center; justify-content: center; width: 86rpx; height: 86rpx; flex: none; border-radius: 50%; background: var(--primary); color: #fff; font-size: 28rpx; font-weight: 800; }
.profile-copy { min-width: 0; }
.eyebrow { display: block; margin-bottom: 8rpx; color: var(--primary); font-size: 19rpx; font-weight: 750; letter-spacing: 2rpx; }
.profile-name { display: block; overflow: hidden; color: var(--text); font-size: 33rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.sync-status { display: flex; align-items: center; gap: 7rpx; margin-top: 7rpx; color: var(--text-dim); font-size: 20rpx; }
.status-dot { display: inline-block; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--warn); }
.pstatus-ok .status-dot { background: var(--success); }
.pstatus-error .status-dot { background: var(--danger); }
.mine-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-bottom: 28rpx; }
.mine-summary view { padding: 17rpx 14rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); }
.mine-summary text { display: block; }
.mine-summary text:first-child { color: var(--text); font-size: 31rpx; font-weight: 750; }
.mine-summary text:last-child { margin-top: 7rpx; color: var(--text-dim); font-size: 19rpx; }

.profile-section { padding: 18rpx 16rpx 16rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-card); }
.section-title-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 16rpx; }
.section-title-row text:first-child { color: var(--text); font-size: 27rpx; font-weight: 700; }
.section-title-row text:last-child { color: var(--text-dim); font-size: 20rpx; }
.profile-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; }
.profile-grid > view { min-width: 0; padding: 14rpx; border-radius: var(--radius-sm); background: var(--surface-2); }
.profile-grid .body-status { grid-column: span 2; border: 1rpx solid var(--primary); background: var(--primary-soft); }
.profile-label, .profile-value, .profile-hint { display: block; }
.profile-label { color: var(--text-dim); font-size: 19rpx; }
.profile-value { margin-top: 8rpx; overflow: hidden; color: var(--text); font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.profile-hint { margin-top: 6rpx; overflow: hidden; color: var(--text-dim); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.body-status .profile-value { color: var(--primary-strong); }

.settings-group { margin-top: 22rpx; border-top: 1rpx solid var(--card-border); }
.group-label { display: block; padding: 18rpx 0 4rpx; color: var(--text-dim); font-size: 20rpx; font-weight: 650; }
.menu-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 78rpx; padding: 14rpx 0; border-bottom: 1rpx solid var(--card-border); }
.menu-item:active { opacity: 0.65; }
.menu-item view:first-child { flex: 1; min-width: 0; }
.menu-item text { display: block; }
.menu-item view:first-child text:first-child { color: var(--text); font-size: 26rpx; font-weight: 650; }
.menu-item view:first-child text:last-child { margin-top: 5rpx; color: var(--text-dim); font-size: 20rpx; }
.menu-item > text:last-child { color: var(--text-dim); font-size: 24rpx; }
.static-item > text:last-child { font-size: 20rpx; }
.switch { position: relative; width: 86rpx; height: 46rpx; flex: none; border-radius: 999rpx; background: var(--surface-3); }
.switch.light { background: var(--primary); }
.switch view { position: absolute; top: 5rpx; left: 5rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: #fff; transition: transform 0.2s ease; }
.switch.light view { transform: translateX(40rpx); }
.mine-foot { display: block; margin-top: 34rpx; color: var(--text-dim); font-size: 19rpx; text-align: center; }
