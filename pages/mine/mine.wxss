.mine-page { padding-top: 24rpx; }
.mine-header { display: flex; align-items: center; gap: 18rpx; margin-bottom: 18rpx; }
.avatar-large { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; flex: none; border-radius: 24rpx; background: linear-gradient(135deg, var(--primary), #9fd42f); color: #12160a; font-size: 28rpx; font-weight: 800; }
.profile-copy { min-width: 0; }
.eyebrow { display: block; margin-bottom: 6rpx; color: var(--primary); font-size: 18rpx; font-weight: 750; letter-spacing: 2rpx; }
.profile-name { display: block; overflow: hidden; color: var(--text); font-size: 31rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.sync-status { display: flex; align-items: center; gap: 7rpx; margin-top: 5rpx; color: var(--text-dim); font-size: 19rpx; }
.status-dot { display: inline-block; width: 9rpx; height: 9rpx; border-radius: 50%; background: var(--warn); }
.pstatus-ok .status-dot { background: var(--success); }
.pstatus-error .status-dot { background: var(--danger); }

.mine-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; margin-bottom: 20rpx; }
.mine-summary view { padding: 13rpx 12rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius-sm); background: var(--surface); }
.mine-summary text { display: block; }
.mine-summary text:first-child { color: var(--text); font-size: 28rpx; font-weight: 750; }
.mine-summary text:last-child { margin-top: 5rpx; color: var(--text-dim); font-size: 18rpx; }

.profile-section { padding: 16rpx 14rpx 14rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-card); }
.section-title-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 13rpx; }
.section-title-row text:first-child { color: var(--text); font-size: 25rpx; font-weight: 700; }
.section-title-row text:last-child { color: var(--text-dim); font-size: 18rpx; }
.profile-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8rpx; }
.profile-grid > view { min-width: 0; padding: 12rpx; border-radius: var(--radius-sm); background: var(--surface-2); }
.profile-grid .body-status { display: flex; align-items: center; gap: 10rpx; grid-column: span 2; border: 1rpx solid var(--primary); background: var(--primary-soft); }
.body-status > view { flex: 1; min-width: 0; }
.profile-label, .profile-value, .profile-hint { display: block; }
.profile-label { color: var(--text-dim); font-size: 18rpx; }
.profile-value { margin-top: 6rpx; overflow: hidden; color: var(--text); font-size: 23rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.profile-hint { flex: none; overflow: hidden; color: var(--text-dim); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.body-status .profile-value { color: var(--primary-strong); }
.body-arrow { flex: none; color: var(--primary); font-size: 25rpx; }

.link-section { margin-top: 18rpx; }
.group-label { display: block; padding: 0 0 8rpx; color: var(--text-dim); font-size: 19rpx; font-weight: 650; }
/* 分组菜单列表：图标底托 + 行式扫读 */
.menu-card { padding: 4rpx 18rpx; border: 1rpx solid var(--card-border); border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow-card); }
.menu-row { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--hairline); }
.menu-row:last-child { border-bottom: none; }
.menu-row:active { opacity: 0.65; }
.menu-ic { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; flex: none; border-radius: 15rpx; }
.menu-ic image { width: 28rpx; height: 28rpx; }
.mi-volt { background: var(--primary-soft); }
.mi-orange { background: var(--accent-soft); }
.mi-teal { background: rgba(91, 200, 175, 0.12); }
.mi-plain { background: var(--surface-3); }
.menu-t { flex: 1; min-width: 0; color: var(--text); font-size: 25rpx; font-weight: 650; }
.menu-a { flex: none; color: var(--text-dim); font-size: 26rpx; }

.settings-group { margin-top: 18rpx; border-top: 1rpx solid var(--card-border); }
.settings-group .group-label { padding-top: 14rpx; }
.menu-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 65rpx; padding: 10rpx 0; border-bottom: 1rpx solid var(--card-border); }
.menu-item:active { opacity: 0.65; }
.menu-item view:first-child { flex: 1; min-width: 0; }
.menu-item text { display: block; }
.menu-item view:first-child text:first-child { color: var(--text); font-size: 24rpx; font-weight: 650; }
.menu-item view:first-child text:last-child { margin-top: 4rpx; color: var(--text-dim); font-size: 18rpx; }
.menu-item > text:last-child { color: var(--text-dim); font-size: 20rpx; }
.static-item > text:last-child { font-size: 18rpx; }
.switch { position: relative; width: 76rpx; height: 42rpx; flex: none; border-radius: 999rpx; background: var(--surface-3); }
.switch.light { background: var(--primary); }
.switch view { position: absolute; top: 4rpx; left: 4rpx; width: 34rpx; height: 34rpx; border-radius: 50%; background: #fff; }
.switch.light view { transform: translateX(34rpx); }
.mine-foot { display: block; margin-top: 26rpx; color: var(--text-dim); font-size: 18rpx; text-align: center; }
